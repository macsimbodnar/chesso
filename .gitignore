build
build-*
*.dSYM
tmp.hpp
tmp.txt
.no_git
chesso_engine.log
config.json
.ref-builds

# The corpus, the fit outputs and the logs stay out: selfplay_v2.tsv alone is
# 715 MB and every one of them is reproducible from a recorded command. The
# scripts do not -- anchors.py is the only executable record of how the pinned
# test values are derived, including the quiescence composite no evaluation
# model can produce. Children of an ignored directory cannot be re-included,
# hence the star.
.tuning/*
!.tuning/*.py
.reprofile

.claude/settings.local.json

# S104. The PGO profile and its instrumented build directory. Regenerated per
# build by build_release.sh and never committed: a profile is a property of one
# workload run against one source tree, and a stale one reads as provenance.
# build-release-<arch>/ is already covered by the build-* above.
.pgo
