+  // S135's cost-only build, never committed (adocs/data/S135_cost.sh applies
+  // this patch to a throwaway tree). Each forced placement count is weighed at
+  // a forced non-zero weight and handed to an asm barrier of its own, so the
+  // compiler has to compute it and the score -- and with it every node the
+  // search visits -- is the shipping build's (DEC-047). S135_COST_MASK picks
+  // the columns: bit f forces column f, 0x7f all seven, 0x07 the three before
+  // S135, 0x78 S135's four. A column whose bit is clear is never read, the
+  // choice made by the preprocessor and `if constexpr`, so it is deleted as it
+  // ships.
+  //
+  // One barrier a column, and no column outside the mask in any expression,
+  // because the first form's single barrier over the whole dot product, a
+  // forced weight of 0 for a clear bit, let g++ 13.3 vectorise columns 0 to 3
+  // into one vpmulld against a constant vector: a zero lane was still loaded
+  // and multiplied, so 0x78 computed all seven and 0x07 computed PL_BAD_BISHOP
+  // beside its three (S135's cost run 1, 2026-10-25).
+  {
+#ifndef S135_COST_MASK
+#define S135_COST_MASK 0x7f
+#endif
+    static_assert(PL_FEATURE_COUNT == 7, "the mask names seven columns");
+    static_assert((S135_COST_MASK) > 0 && (S135_COST_MASK) <= 0x7f,
+                  "S135_COST_MASK forces one to seven of the seven columns");
+    static constexpr int forced[PL_FEATURE_COUNT] = {3, 5, 7, 9, 11, 13, 15};
+
+#define S135_FORCE(f)                                                     \
+  if constexpr ((((S135_COST_MASK) >> (f)) & 1) != 0) {                   \
+    const int forced_term =                                               \
+        (placement[WHITE][f] - placement[BLACK][f]) * forced[f];          \
+    asm volatile("" : : "r"(forced_term));                                \
+  }
+
+    S135_FORCE(0)
+    S135_FORCE(1)
+    S135_FORCE(2)
+    S135_FORCE(3)
+    S135_FORCE(4)
+    S135_FORCE(5)
+    S135_FORCE(6)
+#undef S135_FORCE
+  }
