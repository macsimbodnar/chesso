+// One slot of the evaluation cache, S120: the full evaluate() score of one
+// position, found by its zobrist key. The upper 48 bits of the key are kept as
+// a tag and the score sits in the low 16, offset by 32768, so a slot is one
+// load and one compare and an all-zero slot -- an empty one -- decodes to
+// INT16_MIN, which no evaluation returns and which therefore reads as a miss.
+// The tag and the index bits below it between them cover all 64 bits of the
+// key, so a slot answers a different position only on a full key collision,
+// the same one the transposition table already lives with.
+//
+// The score and never a bound: a bound is true on one side of one window and
+// a slot outlives the window (S094's reason). Direct-mapped and replaced on
+// every store, because size matters more than the scheme here (section 4 of
+// the step file). The table itself is in src/evaluation.cpp.
+using eval_cache_slot_t = uint64_t;
+
+// 65536 slots, 512 KiB. A seed, re-decided by measurement: S120's sweep over
+// 2^15 to 2^19 slots against nodes per second, its step file has the figures.
+constexpr size_t EVAL_CACHE_ENTRIES = size_t{1} << 16;
+
+static_assert((EVAL_CACHE_ENTRIES & (EVAL_CACHE_ENTRIES - 1)) == 0,
+              "the evaluation cache is indexed by a mask");
+
+
 struct search_t
 {
   move_t best_move;
diff --git a/src/evaluation.cpp b/src/evaluation.cpp
index ce2495f..154e528 100644
--- a/src/evaluation.cpp
+++ b/src/evaluation.cpp
@@ -1150,6 +1150,61 @@ void evaluate_expensive_terms(const board_t* board, int* mobility, int* safety)
 }
 
 
+// THE EVALUATION CACHE, S120. What it is for: evaluate_expensive() is most of
+// what evaluate() costs and quiescence asks for it at nearly every node, while
+// the transposition table hands a static score back to quiescence on under 1 %
+// of them (S094) -- a quiescence entry sits below every main-search depth and
+// the first main store over its slot evicts it. This table is the guaranteed
+// storage beside that opportunistic one (S108 section 7), and the two are not
+// merged.
+//
+// thread_local, so it is per thread and never shared; evaluation.hpp says what
+// that means for each caller. Zeroed at thread start, and zero is an empty
+// slot. The layout is eval_cache_slot_t's, in data_structures.hpp.
+static thread_local eval_cache_slot_t eval_cache[EVAL_CACHE_ENTRIES];
+
+static constexpr uint64_t EVAL_CACHE_TAG_MASK = ~uint64_t{0xFFFF};
+static constexpr uint64_t EVAL_CACHE_INDEX_MASK = EVAL_CACHE_ENTRIES - 1;
+static constexpr int EVAL_CACHE_OFFSET = 32768;
+
+
+bool eval_cache_probe(uint64_t key, int* score)
+{
+  const eval_cache_slot_t entry = eval_cache[key & EVAL_CACHE_INDEX_MASK];
+  const uint32_t offset_score = static_cast<uint32_t>(entry & 0xFFFF);
+
+  // A slot holding another position, or nothing: an empty slot's score half
+  // is 0, which is the offset form of INT16_MIN and of no evaluation.
+  if (((entry ^ key) & EVAL_CACHE_TAG_MASK) != 0 || offset_score == 0) {
+    return false;
+  }
+
+  *score = static_cast<int>(offset_score) - EVAL_CACHE_OFFSET;
+  return true;
+}
+
+
+void eval_cache_store(uint64_t key, int score)
+{
+  const uint32_t offset_score =
+      static_cast<uint32_t>(score + EVAL_CACHE_OFFSET);
+
+  // Kept only inside (INT16_MIN, INT16_MAX]. Nothing the evaluation returns
+  // comes near either end (tt_entry_t::eval has the measurement), and a score
+  // that did would be recomputed rather than stored wrong: clamping it, as the
+  // transposition table's field does, would hand back a number evaluate() did
+  // not return. One unsigned compare covers both ends.
+  if (offset_score - 1 >= 0xFFFF) { return; }
+
+  eval_cache[key & EVAL_CACHE_INDEX_MASK] =
+      (key & EVAL_CACHE_TAG_MASK) | offset_score;
+}
+
+
+void eval_cache_clear()
+{ std::memset(eval_cache, 0, sizeof(eval_cache)); }
+
+
 int evaluate_lazy(const board_t* board, int alpha, int beta, bool* exact)
 {
   const int cheap = evaluate_cheap(board);
@@ -1168,10 +1223,21 @@ int evaluate_lazy(const board_t* board, int alpha, int beta, bool* exact)
 
   if (exact != nullptr) { *exact = true; }
 
+  // Asked only where the full score is owed, so a hit returns the number the
+  // line below would have computed -- the slot holds evaluate()'s output for
+  // this key -- and the two shortcuts above store nothing. S120.
+  int cached = 0;
+
+  if (eval_cache_probe(board->hash, &cached)) { return cached; }
+
   // Identical to evaluate() by construction: that function is these two terms
   // added, so the number kept here is the static evaluation and not an
   // approximation of it.
-  return cheap + evaluate_expensive(board);
+  const int full = cheap + evaluate_expensive(board);
+
+  eval_cache_store(board->hash, full);
+
+  return full;
 }
 
 
