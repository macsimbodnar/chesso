+// S120. evaluate_lazy() keeps every full score it pays for, by the position's
+// key, and returns it the next time the position asks. Whatever comes back
+// from the table has to be the number evaluate() returns for that position --
+// never a bound, never another position's score -- and these cases read the
+// table directly to show it, rather than trusting a search to notice. Each
+// starts on an empty table, which eval_fixture_t sees to.
+TEST_SUITE("evaluation: cache")
+{
+  // A window that contains the score, so evaluate_lazy() owes the full one.
+  static int lazy_wide(const board_t* board, bool* exact)
+  {
+    const int full = evaluate(board);
+    return evaluate_lazy(board, full - 1000, full + 1000, exact);
+  }
+
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "a second call reads back what the first one computed")
+  {
+    size_t checked = 0;
+
+    for (const std::string& fen : all_test_fens()) {
+      REQUIRE_MESSAGE(load_FEN(fen, &game), ("FEN: " + fen));
+      eval_cache_clear();
+
+      const int full = evaluate(&game.board);
+      int cached = 0;
+
+      // An empty table answers nothing, so whatever the probe finds after the
+      // first call is what that call stored.
+      REQUIRE_FALSE(eval_cache_probe(game.board.hash, &cached));
+
+      bool exact = false;
+      REQUIRE_EQ(lazy_wide(&game.board, &exact), full);
+      REQUIRE(exact);
+
+      REQUIRE_MESSAGE(eval_cache_probe(game.board.hash, &cached),
+                      ("FEN: " + fen));
+      REQUIRE_MESSAGE(cached == full, ("FEN: " + fen));
+
+      exact = false;
+      REQUIRE_MESSAGE(lazy_wide(&game.board, &exact) == full, ("FEN: " + fen));
+      REQUIRE(exact);
+
+      checked++;
+    }
+
+    REQUIRE(checked > 100);
+  }
+
+  // That evaluate_lazy() reads the slot at all, shown the way S103 showed the
+  // transposition entry's: plant a number evaluate() does not return and see
+  // it come back. Everywhere else in this suite a hit and a recomputation give
+  // the same answer, so only a planted value tells them apart.
+  //
+  // Planted on the start position and read four plies later, after both
+  // knights have gone out and come home: the same position under a halfmove
+  // clock of 4, which the key does not cover. So it is the position that finds
+  // the slot, and not the visit.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "evaluate_lazy answers from the slot where the full score "
+                    "is owed")
+  {
+    REQUIRE(load_FEN(DEFAULT_POSITION, &game));
+
+    const int full = evaluate(&game.board);
+    const int cheap = evaluate_cheap(&game.board);
+    const int planted = full + 7;
+
+    eval_cache_store(game.board.hash, planted);
+
+    REQUIRE(play_move(&game, g1, f3));
+    REQUIRE(play_move(&game, g8, f6));
+    REQUIRE(play_move(&game, f3, g1));
+    REQUIRE(play_move(&game, f6, g8));
+    REQUIRE_EQ(game.board.halfmove_clock, 4);
+    REQUIRE_EQ(evaluate(&game.board), full);
+
+    bool exact = false;
+    CHECK_EQ(evaluate_lazy(&game.board, full - 1000, full + 1000, &exact),
+             planted);
+    CHECK(exact);
+
+    // Where the shortcut answers, it answers first and the slot is not asked:
+    // the bound comes back, flagged as one.
+    const int beta = cheap - LAZY_EVAL_MARGIN;
+    exact = true;
+    CHECK_EQ(evaluate_lazy(&game.board, beta - 1000, beta, &exact), beta);
+    CHECK_FALSE(exact);
+
+    const int alpha = cheap + LAZY_EVAL_MARGIN;
+    exact = true;
+    CHECK_EQ(evaluate_lazy(&game.board, alpha, alpha + 1000, &exact), alpha);
+    CHECK_FALSE(exact);
+
+    // The planted number is not the start position's score, and nothing after
+    // this case should meet it.
+    eval_cache_clear();
+  }
+
+  // The INV-2 pattern: a line made and unmade, every node on it stored on the
+  // way down and read back on the way up. The line starts with both knights
+  // going out and coming home, so the fourth ply is the root again with the
+  // halfmove clock at 4 -- a field the key does not cover and evaluate() does
+  // not read, and the slot has to answer it with the root's score.
+  //
+  // Always-replace means a later node on the line that shares a slot with an
+  // earlier one evicts it, so a miss is expected exactly there and nowhere
+  // else.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "a position reached again reads back its own score")
+  {
+    REQUIRE(load_FEN(DEFAULT_POSITION, &game));
+
+    const index_t shuffle[4][2] = {{g1, f3}, {g8, f6}, {f3, g1}, {f6, g8}};
+    constexpr int LINE = 10;
+
+    uint64_t keys[LINE + 1];
+    int scores[LINE + 1];
+    bool exact = false;
+
+    keys[0] = game.board.hash;
+    scores[0] = evaluate(&game.board);
+    REQUIRE_EQ(lazy_wide(&game.board, &exact), scores[0]);
+
+    for (int ply = 1; ply <= LINE; ++ply) {
+      if (ply <= 4) {
+        REQUIRE(play_move(&game, shuffle[ply - 1][0], shuffle[ply - 1][1]));
+      } else {
+        // Past the shuffle, the first legal move, so the line is the
+        // generator's and not a judgement of the position (DEC-023).
+        move_t moves[MAX_MOVES];
+        REQUIRE(legal_moves(&game, moves) > 0);
+        REQUIRE(make_move(&game, moves[0]));
+      }
+
+      keys[ply] = game.board.hash;
+      scores[ply] = evaluate(&game.board);
+
+      if (ply == 4) {
+        // The precondition the transposition needs: the root's key, under a
+        // halfmove clock that is not the root's.
+        REQUIRE_EQ(keys[4], keys[0]);
+        REQUIRE_EQ(game.board.halfmove_clock, 4);
+
+        int cached = 0;
+        REQUIRE(eval_cache_probe(keys[4], &cached));
+        REQUIRE_EQ(cached, scores[0]);
+      }
+
+      REQUIRE_EQ(lazy_wide(&game.board, &exact), scores[ply]);
+    }
+
+    size_t hits = 0;
+
+    for (int ply = LINE; ply >= 0; --ply) {
+      bool evicted = false;
+
+      for (int later = ply + 1; later <= LINE; ++later) {
+        if (keys[later] != keys[ply] &&
+            (keys[later] & (EVAL_CACHE_ENTRIES - 1)) ==
+                (keys[ply] & (EVAL_CACHE_ENTRIES - 1))) {
+          evicted = true;
+        }
+      }
+
+      REQUIRE_EQ(game.board.hash, keys[ply]);
+
+      int cached = 0;
+      const bool hit = eval_cache_probe(keys[ply], &cached);
+
+      CHECK_EQ(hit, !evicted);
+      if (hit) {
+        CHECK_EQ(cached, scores[ply]);
+        CHECK_EQ(cached, evaluate(&game.board));
+        hits++;
+      }
+
+      if (ply > 0) { unmake_move(&game); }
+    }
+
+    REQUIRE(hits > LINE / 2);
+  }
+
+  TEST_CASE_FIXTURE(eval_fixture_t, "a shortcut stores nothing")
+  {
+    size_t checked = 0;
+
+    for (const std::string& fen : all_test_fens()) {
+      REQUIRE_MESSAGE(load_FEN(fen, &game), ("FEN: " + fen));
+      eval_cache_clear();
+
+      const int cheap = evaluate_cheap(&game.board);
+      int cached = 0;
+
+      // Each shortcut first shown to have been taken -- the flag says bound --
+      // and only then the table shown empty, so a miss here is the shortcut
+      // keeping nothing and not a call that never reached it.
+      const int beta = cheap - LAZY_EVAL_MARGIN;
+      bool exact = true;
+      evaluate_lazy(&game.board, beta - 1000, beta, &exact);
+      REQUIRE_FALSE(exact);
+      REQUIRE_FALSE_MESSAGE(eval_cache_probe(game.board.hash, &cached),
+                            ("FEN: " + fen + " at beta"));
+
+      const int alpha = cheap + LAZY_EVAL_MARGIN;
+      exact = true;
+      evaluate_lazy(&game.board, alpha, alpha + 1000, &exact);
+      REQUIRE_FALSE(exact);
+      REQUIRE_FALSE_MESSAGE(eval_cache_probe(game.board.hash, &cached),
+                            ("FEN: " + fen + " at alpha"));
+
+      // And the same key does reach the table once the full score is paid, so
+      // the two misses above are the shortcut's and not a slot this position
+      // can never fill.
+      REQUIRE_EQ(lazy_wide(&game.board, &exact), evaluate(&game.board));
+      REQUIRE(eval_cache_probe(game.board.hash, &cached));
+
+      checked++;
+    }
+
+    REQUIRE(checked > 100);
+  }
+
+  // A slot is found by the low bits of the key and claimed by the high ones,
+  // so two positions can land in one slot and must not read each other's
+  // score. Every single-bit change to a key that has been stored misses:
+  // below the index width that is another slot, at or above it the same slot
+  // under another tag.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "a slot answers only the key that filled it")
+  {
+    REQUIRE(load_FEN(KIWIPETE_POS, &game));
+
+    const uint64_t key = game.board.hash;
+    const int score = evaluate(&game.board);
+    int cached = 0;
+
+    eval_cache_store(key, score);
+    REQUIRE(eval_cache_probe(key, &cached));
+    REQUIRE_EQ(cached, score);
+
+    for (int bit = 0; bit < 64; ++bit) {
+      CHECK_FALSE_MESSAGE(eval_cache_probe(key ^ (uint64_t{1} << bit), &cached),
+                          ("bit " + std::to_string(bit)));
+    }
+
+    // The top bit is above every index width the table can have, so this is
+    // the same slot under another tag, and storing it replaces the first.
+    const uint64_t same_slot = key ^ (uint64_t{1} << 63);
+    REQUIRE_EQ(same_slot & (EVAL_CACHE_ENTRIES - 1),
+               key & (EVAL_CACHE_ENTRIES - 1));
+
+    eval_cache_store(same_slot, -score);
+    REQUIRE(eval_cache_probe(same_slot, &cached));
+    CHECK_EQ(cached, -score);
+    CHECK_FALSE(eval_cache_probe(key, &cached));
+
+    // An empty slot is all zeros, which would read as a score of 0 for any
+    // key whose upper bits are zero if the empty state were not refused.
+    eval_cache_clear();
+    CHECK_FALSE(eval_cache_probe(0, &cached));
+    CHECK_FALSE(eval_cache_probe(0x1234, &cached));
+  }
+
+  // INV-5: the mirror of a position is worth the same to the side to move, and
+  // the same placement with the other side to move is worth the negative of
+  // it, nothing in the evaluation being about whose turn it is while tempo
+  // ships at zero. The first pair cannot show a slot answering the wrong
+  // position, the numbers being equal; the second can, and is what gives the
+  // case teeth -- a key that ignored the side to move would hand the first
+  // position's score to the second.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "a position, its mirror and its other side to move each "
+                    "read back their own score")
+  {
+    size_t mirrored_pairs = 0;
+    size_t turned_pairs = 0;
+
+    for (const std::string& fen : all_test_fens()) {
+      eval_cache_clear();
+
+      REQUIRE_MESSAGE(load_FEN(fen, &game), ("FEN: " + fen));
+      const uint64_t key = game.board.hash;
+      const int full = evaluate(&game.board);
+      bool exact = false;
+      REQUIRE_EQ(lazy_wide(&game.board, &exact), full);
+
+      // The mirror, with the original already in the table.
+      REQUIRE(load_FEN(mirror_fen(fen), &mirrored));
+      REQUIRE_NE(mirrored.board.hash, key);
+      const int mirrored_full = evaluate(&mirrored.board);
+      REQUIRE_EQ(mirrored_full, full);
+      REQUIRE_EQ(lazy_wide(&mirrored.board, &exact), mirrored_full);
+      mirrored_pairs++;
+
+      // The other side to move, where the position is one a game can have.
+      std::vector<std::string> fields = split_string(fen);
+      REQUIRE(fields.size() >= 4);
+      fields[1] = (fields[1] == "w") ? "b" : "w";
+      fields[3] = "-";  // an en passant square belongs to the side it was
+      std::string turned;
+      for (const std::string& field : fields) {
+        turned += (turned.empty() ? "" : " ") + field;
+      }
+
+      if (load_FEN(turned, &mirrored) && position_is_reachable(&mirrored)) {
+        REQUIRE_NE(mirrored.board.hash, key);
+        const int turned_full = evaluate(&mirrored.board);
+        REQUIRE_EQ(lazy_wide(&mirrored.board, &exact), turned_full);
+        if (turned_full != full) { turned_pairs++; }
+      }
+
+      // And the original still reads back its own, both others stored since.
+      REQUIRE(load_FEN(fen, &game));
+      REQUIRE_EQ(lazy_wide(&game.board, &exact), full);
+    }
+
+    REQUIRE(mirrored_pairs > 100);
+
+    // Non-vacuous: pairs whose two scores differ, on which a wrong answer is
+    // visible.
+    REQUIRE(turned_pairs > 100);
+  }
+
+  TEST_CASE_FIXTURE(eval_fixture_t, "a clear empties the table")
+  {
+    std::vector<uint64_t> keys;
+    int cached = 0;
+    bool exact = false;
+
+    for (const std::string& fen : all_test_fens()) {
+      REQUIRE(load_FEN(fen, &game));
+      lazy_wide(&game.board, &exact);
+      keys.push_back(game.board.hash);
+    }
+
+    // Precondition: the table holds something, so the misses below are the
+    // clear's doing. The last key stored is in its slot whatever came before.
+    REQUIRE(eval_cache_probe(keys.back(), &cached));
+
+    eval_cache_clear();
+
+    size_t answered = 0;
+    for (const uint64_t key : keys) {
+      if (eval_cache_probe(key, &cached)) { answered++; }
+    }
+
+    REQUIRE_EQ(answered, 0);
+  }
+
+  // A test that resets the transposition table to search from a clean state
+  // relies on this, and so does `ucinewgame`: tt_reset() empties the calling
+  // thread's evaluation cache as well.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "a transposition table reset empties the table too")
+  {
+    REQUIRE(load_FEN(KIWIPETE_POS, &game));
+    bool exact = false;
+    int cached = 0;
+    lazy_wide(&game.board, &exact);
+    REQUIRE(eval_cache_probe(game.board.hash, &cached));
+
+    transposition_table_t table = {};
+    tt_resize(&table, 1);
+    tt_reset(&table);
+    tt_free(&table);
+
+    REQUIRE_FALSE(eval_cache_probe(game.board.hash, &cached));
+  }
+
+  // thread_local: what one thread stores, another does not see. datagen's
+  // workers rely on it to stay reproducible, each searching on a table only
+  // its own games have written.
+#ifdef CHESSO_TUNE
+  // LazyEvalMargin is the one parameter evaluate() reads -- the clamp every
+  // stored score was computed under -- so setting it empties this thread's
+  // table, the one `bench` and `test` search on. Another parameter does not:
+  // that is the precondition showing the slot would have answered.
+  TEST_CASE_FIXTURE(eval_fixture_t,
+                    "setting LazyEvalMargin empties the table, another "
+                    "parameter does not")
+  {
+    uci_init();
+
+    REQUIRE(load_FEN(KIWIPETE_POS, &game));
+    const uint64_t key = game.board.hash;
+    const int score = evaluate(&game.board);
+    int cached = 0;
+
+    eval_cache_store(key, score);
+    uci_process_line("setoption name RfpMargin value " +
+                     std::to_string(RFP_MARGIN));
+    REQUIRE(eval_cache_probe(key, &cached));
+
+    uci_process_line("setoption name LazyEvalMargin value " +
+                     std::to_string(LAZY_EVAL_MARGIN));
+    CHECK_FALSE(eval_cache_probe(key, &cached));
+
+    uci_shutdown();
+  }
+#endif
+
+  TEST_CASE_FIXTURE(eval_fixture_t, "each thread has a table of its own")
+  {
+    REQUIRE(load_FEN(KIWIPETE_POS, &game));
+    const uint64_t key = game.board.hash;
+    const int score = evaluate(&game.board);
+    int cached = 0;
+
+    eval_cache_store(key, score);
+    REQUIRE(eval_cache_probe(key, &cached));
+
+    bool seen_there = true;
+    bool own_there = false;
+    std::thread other([&]() {
+      int there = 0;
+      seen_there = eval_cache_probe(key, &there);
+      eval_cache_store(key ^ (uint64_t{1} << 63), score);
+      own_there = eval_cache_probe(key ^ (uint64_t{1} << 63), &there);
+    });
+    other.join();
+
+    CHECK_FALSE(seen_there);
+    CHECK(own_there);
+
+    // And what that thread stored did not land here: this slot still holds
+    // this thread's key.
+    REQUIRE(eval_cache_probe(key, &cached));
+    CHECK_EQ(cached, score);
+  }
+}
