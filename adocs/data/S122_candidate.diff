+// The fixture-level readings DEC-316's rows can move: the gradient case's worst (shipped
+// constants, h 0.01, every parameter) and the largest |stage two| at the shipped constants.
+void fixture_readings(const dataset_t& data, const std::vector<double>& start, const char* label)
+{
+  const eval_t e = every(data);
+  const std::vector<double> ana = analytic_of(data, start, e.index, e.target);
+  const worst_t w = worst_rel(numeric_of(data, start, 0.01, e), ana);
+  double clear = 0.0;
+  for (size_t row = 0; row < data.size(); ++row) {
+    clear = std::max(clear, std::fabs(stage_two(data, row, start.data())));
+  }
+  printf("%s: %zu rows; the gradient case's worst %.3e at %zu %s; the fixture's largest |stage two| %.1f\n", label,
+         data.size(), w.value, w.param, param_name(w.param).c_str(), clear);
+}
+
+double stage_two_of(const std::string& fen, const std::vector<double>& start, int* engine_white, int* phase)
+{
+  if (!load_FEN(fen, &game)) { return 1e300; }
+  tuner_trace::row_trace_t trace;
+  std::string error;
+  if (!tuner_trace::trace_board(&game.board, &trace, &error)) { return 1e300; }
+  *engine_white = trace.engine_white;
+  *phase = trace.phase;
+  dataset_t one;
+  if (!load_rows({fen}, &one)) { return 1e300; }
+  return stage_two(one, 0, start.data());
+}
+
+std::string with_side_to_move(const std::string& fen, char side)
+{
+  std::string flipped = fen;
+  flipped[fen.find(' ') + 1] = side;
+  return flipped;
+}
+
+bool loads_either_side(const std::string& fen)
+{
+  return load_FEN(with_side_to_move(fen, 'w'), &game) && load_FEN(with_side_to_move(fen, 'b'), &game);
+}
+
+std::string canonical_castling(const std::string& fen)
+{
+  std::vector<std::string> parts = split_string(fen);
+  if (parts.size() != 6 || parts[2] == "-") { return fen; }
+  std::string rights;
+  for (const char c : std::string("KQkq")) {
+    if (parts[2].find(c) != std::string::npos) { rights += c; }
+  }
+  parts[2] = rights;
+  std::string out;
+  for (size_t i = 0; i < parts.size(); ++i) { out += (i ? " " : "") + parts[i]; }
+  return out;
+}
+
+bool eligible(const std::string& fen, const std::string& mirror, const std::vector<double>& start)
+{
+  int ew = 0, em = 0, pw = 0, pm = 0;
+  const double a = stage_two_of(fen, start, &ew, &pw);
+  const double b = stage_two_of(mirror, start, &em, &pm);
+  const double margin = static_cast<double>(LAZY_EVAL_MARGIN);
+  return a < 1e299 && b < 1e299 && pw >= 1 && pw <= GAME_PHASE_MAX - 1 && std::fabs(a) < margin - 1.0 &&
+         std::fabs(b) < margin - 1.0 && std::abs(ew) <= 800 && std::abs(em) <= 800 && loads_either_side(fen) &&
+         loads_either_side(mirror);
+}
+
+// S101_gradient_rows.cpp's rule for TARGET over ROWS: the first eligible pair of all_test_fens()
+// that puts |dE/d TARGET| at the shipped constants at or above 3 times the list's.
+bool pick_pair(const std::vector<std::string>& rows, size_t target, const std::vector<double>& start,
+               std::string* fen_out, std::string* mirror_out)
+{
+  dataset_t base;
+  if (!load_rows(rows, &base)) { return false; }
+  const eval_t eb = every(base);
+  const double g0 = std::fabs(analytic_of(base, start, eb.index, eb.target)[target]);
+  printf("pair for %zu %s: base |g| %.6e over %zu rows, the rule wants %.6e\n", target, param_name(target).c_str(), g0,
+         rows.size(), 3.0 * g0);
+  size_t tried = 0;
+  for (const std::string& fen : all_test_fens()) {
+    const std::string mirror = canonical_castling(mirror_fen(fen));
+    bool known = false;
+    for (const std::string& row : rows) {
+      if (row == fen || row == mirror) { known = true; }
+    }
+    if (known || !eligible(fen, mirror, start)) { continue; }
+    std::vector<std::string> with = rows;
+    with.push_back(fen);
+    with.push_back(mirror);
+    dataset_t data;
+    if (!load_rows(with, &data)) {
+      printf("  an eligible pair failed to load: %s\n", fen.c_str());
+      return false;
+    }
+    tried++;
+    const eval_t e = every(data);
+    const double g = std::fabs(analytic_of(data, start, e.index, e.target)[target]);
+    if (g >= 3.0 * g0) {
+      printf("  pick after %zu eligible pairs: |g| %.6e\n    \"%s\",\n    \"%s\",\n", tried, g, fen.c_str(),
+             mirror.c_str());
+      *fen_out = fen;
+      *mirror_out = mirror;
+      return true;
+    }
+  }
+  printf("  none of %zu eligible pairs triples it\n", tried);
+  return false;
+}
+
+std::vector<row_t> sweep(const dataset_t& data, const std::vector<double>& start, int lo, int hi, int step)
+{
+  std::vector<row_t> rows;
+  for (int push = lo; push <= hi; push += step) { rows.push_back(read_push(data, start, push)); }
+  return rows;
+}
+
+
+// The gradient case at the shipped constants: D at h and h/2 over every parameter.
+struct grad_t { std::vector<double> ana, d1, d2; };
+grad_t grad_case(const dataset_t& data, const std::vector<double>& start, double h)
+{
+  const eval_t e = every(data);
+  grad_t g;
+  g.ana = analytic_of(data, start, e.index, e.target);
+  g.d1 = numeric_of(data, start, h, e);
+  g.d2 = numeric_of(data, start, h / 2.0, e);
+  return g;
+}
+std::vector<double> richardson(const std::vector<double>& d1, const std::vector<double>& d2)
+{
+  std::vector<double> r(d1.size());
+  for (size_t p = 0; p < r.size(); ++p) { r[p] = (4.0 * d2[p] - d1[p]) / 3.0; }
+  return r;
+}
+void print_grad(const grad_t& g, const char* label)
+{
+  const worst_t r = worst_rel(g.d1, g.ana), b = worst_rel(g.d2, g.ana), f = worst_rel(richardson(g.d1, g.d2), g.ana);
+  double top = 0.0; size_t at = 0;
+  for (size_t p = 0; p < g.ana.size(); ++p) { if (std::fabs(g.ana[p]) > top) { top = std::fabs(g.ana[p]); at = p; } }
+  double diff = 0.0; size_t dat = 0;
+  for (size_t p = 0; p < g.ana.size(); ++p) { if (std::fabs(g.d1[p] - g.ana[p]) > diff) { diff = std::fabs(g.d1[p] - g.ana[p]); dat = p; } }
+  printf("%-34s (R) rel h.01 %9.3e at %4zu %-24s | (B) rel h.005 %9.3e at %4zu %-24s | (C) normwise h.01 %9.3e (max |diff| %.3e at %zu, max |ana| %.3e at %zu) | (F) Richardson %9.3e at %4zu %s\n",
+         label, r.value, r.param, param_name(r.param).c_str(), b.value, b.param, param_name(b.param).c_str(),
+         normwise(g.d1, g.ana), diff, dat, top, at, f.value, f.param, param_name(f.param).c_str());
+}
+}  // namespace
+
+TEST_CASE("S122 gradient options")
+{
+  initialize_game_const_data(&game);
+  std::vector<double> start(PARAM_COUNT, 0.0);
+  starting_params(start.data());
+  const char* mode = std::getenv("GRADOPTS_MODE");
+  const std::vector<std::string>& landed = test_eval_positions::positions;
+  REQUIRE(landed.size() == 106);
+  const std::vector<std::string> base(landed.begin(), landed.begin() + 104);
+  std::vector<std::string> repick = base;
+  repick.push_back("1r2k2r/R3P2R/8/8/8/8/8/4K3 w k - 1 2");
+  repick.push_back("4k3/8/8/8/8/8/r3p2r/1R2K2R b K - 1 2");
+  printf("the landed pair: %s | %s\n", landed[104].c_str(), landed[105].c_str());
+
+  if (mode && std::string(mode) == "parent") {
+    dataset_t data;
+    REQUIRE(load_rows(base, &data));
+    printf("== the parent's library (S101's constants as shipped, the family at its seed), the 104 base rows, h 0.01\n");
+    print_grad(grad_case(data, start, 0.01), "parent, 104 base rows");
+    dataset_t with_pair;  // a fresh dataset: load() appends to the one it is given
+    REQUIRE(load_rows(landed, &with_pair));
+    print_grad(grad_case(with_pair, start, 0.01), "parent, 106 rows (S101's pair)");
+    return;
+  }
+
+  // One fd pass's cost, one thread, as the case runs it.
+  {
+    dataset_t data;
+    REQUIRE(load_rows(landed, &data));
+    const eval_t e = every(data);
+    THREADS = 1;
+    const auto t0 = std::chrono::steady_clock::now();
+    (void)numeric_of(data, start, 0.01, e);
+    const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    THREADS = 1;
+    printf("one central-difference pass over %zu parameters, 106 rows, one thread: %.3f s\n", start.size(), s);
+  }
+
+  printf("\n== the gradient case at the candidate, K 1, bound 1e-6, every parameter\n");
+  for (const auto& [rows, label] : {std::pair{landed, "(i) the landed S101 pair, 106 rows"},
+                                    std::pair{repick, "(ii) the re-pick, candidate 5, 106"},
+                                    std::pair{base, "(iii) no pair, 104 rows"}}) {
+    dataset_t data;
+    REQUIRE(load_rows(rows, &data));
+    print_grad(grad_case(data, start, 0.01), label);
+  }
+
+  const std::vector<option_t> options = {
+      {"(R) rule, rel h.005 <= 2e-7", [](const row_t& r) { return r.r005.value; }, 2e-7},
+      {"(B) rel h.0025 <= 2e-7", [](const row_t& r) { return r.r0025.value; }, 2e-7},
+      {"(C) normwise h.005 <= 2e-7", [](const row_t& r) { return r.norm005; }, 2e-7},
+      {"(F) Richardson <= 2e-7", [](const row_t& r) { return r.rich.value; }, 2e-7},
+      {"(D) rel h.005 <= 1e-6", [](const row_t& r) { return r.r005.value; }, 1e-6},
+  };
+  for (const auto& [rows, label] : {std::pair{landed, "the landed fixture (S101's pair)"},
+                                    std::pair{repick, "the re-picked fixture (candidate 5)"}}) {
+    dataset_t data;
+    REQUIRE(load_rows(rows, &data));
+    printf("\n== the clamp case on %s, pushes +10 to +200 by 5\n", label);
+    const std::vector<row_t> table = sweep(data, start, 10, 200, 5);
+    print_table(table);
+    report_options(table, options);
+  }
+}
diff --git a/adocs/data/S122_kcheck.sh b/adocs/data/S122_kcheck.sh
new file mode 100755
index 0000000000000000000000000000000000000000..54fd474f19fc7d74609d61ceff6504e7e339ffa9
--- /dev/null
+++ b/adocs/data/S122_kcheck.sh
@@ -0,0 +1,145 @@
+#!/usr/bin/env bash
+# S122 phase 2, DEC-352's re-read: each part's decided pair read on the fixed set
+# at K refit at the candidate's constants, beside the K the screen used. A check
+# and not a decision (DEC-352, DEC-353): it refits nothing and moves no golden.
+#
+#   adocs/data/S122_kcheck.sh            # from the worktree that holds the paste
+#
+# Written before it ran, 2026-11-05.
+#
+# K. The screen fitted K once at M by a zero-epoch tuner run at the landing's
+# constants on the full corpus (S122_screen.sh k_probe, OUT/k/full.k). Here
+# the same command runs twice: with the screen's own frozen tuner, which must
+# reproduce OUT/k/full.k to four places, and with this tree's build-tune tuner,
+# whose constants are the paste's (`.tuning/verify_fit.py` must find every
+# parameter the fit's). The tuner's fit_k() is a 40-step ternary search over K
+# at fixed constants, and DEC-353 refits nothing, so one round is the fixed
+# point: a second round would search the same function again.
+#
+# THE READING. For each part P1 to P7 its reading's DECIDED line names the fit
+# and the fit it was decided against (P1's against its start, the landing's
+# shipped constants). Each fit's full vector is read on the fixed set's qs view
+# by the margin_census of the tree its tree.txt names (the landing's, or the
+# variant's built by the screen), at margin 275 and at each K: `--games`, the
+# summed sse over the summed rows. d = mse(against) - mse(fit), at each K.
+#
+# THE STOP (the brief, DEC-352): a part kept by DEC-353 -- P1, P2, P4, P5 --
+# whose d at the refit K is at or under its screen m, or of the other sign from
+# its screen d, prints STOP, the coordinator's before any SPRT. P3, P6 and P7
+# (dropped by the screen or by DEC-353) are read and decide nothing.
+#
+# Prints S122-KCHECK-DONE, S122-KCHECK-STOP or S122-KCHECK-FAILED last.
+
+set -uo pipefail
+
+root="$(cd "$(dirname "$0")/../.." && pwd)"
+main=$(dirname "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)")
+OUT="${OUT:-$main/.tuning/s122/screen}"
+PREPARED="${PREPARED:-$main/.tuning/s122/prepared/prepared.txt}"
+WORK="${WORK:-$main/.tuning/s122p2/kcheck}"
+FIT="$OUT/fits/1245_e20000/full.hpp"
+MARGIN=275
+FREE_GROUPS="ks_checks,ks_weak,ks_defenders,ks_storm,ks_curve"
+KEPT="P1 P2 P4 P5"
+
+fail() { echo "$*"; echo "S122-KCHECK-FAILED"; exit 1; }
+# Inside a command substitution: the reason to stderr, and the caller fails.
+die() { echo "$*" >&2; exit 1; }
+check_copy() {
+  [[ "$(sha256sum "$1" | cut -d' ' -f1)" == "$(cat "$1.sha256")" ]] ||
+    die "refused: $1 is not the binary the screen froze"
+}
+
+mkdir -p "$WORK" || fail "cannot create $WORK"
+corpus=$(sed -n 's/^corpus //p' "$PREPARED" | head -n 1)
+holdout=$(awk '$1 == "view" && $2 == "qs" { print $3 }' "$PREPARED")
+[[ -f "$corpus" && -f "$holdout" ]] || fail "refused: $PREPARED names no corpus or qs view"
+[[ "$(sha256sum "$corpus" | cut -d' ' -f1)" == "$(sed -n 's/^sha256 //p' "$PREPARED" | head -n 1)" ]] ||
+  fail "refused: $corpus is not the corpus $PREPARED records"
+[[ "$(awk '$1 == "MARGIN" { print $2 }' "$OUT/margin/M.txt")" == "$MARGIN" ]] ||
+  fail "refused: the screen's margin is not $MARGIN"
+
+echo "S122 kcheck, $(date -Iseconds), tree $root at $(git -C "$root" rev-parse --short HEAD)"
+python3 "$root/.tuning/verify_fit.py" "$FIT" --root "$root" || fail "refused: $root does not hold DEC-353's fit"
+
+# K at the landing's constants by the screen's frozen tuner, then at the paste's.
+k_of() {
+  local tuner="$1" name="$2"
+  "$tuner" --data "$corpus" --holdout "$holdout" --out "$WORK/$name.hpp" --margin "$MARGIN" \
+      --epochs 0 --only "$FREE_GROUPS" --threads 12 > "$WORK/$name.log" 2>&1 ||
+    die "the K probe $name failed: $WORK/$name.log"
+  sed -n 's/^fitted K = \([0-9.]*\)$/\1/p' "$WORK/$name.log"
+}
+check_copy "$OUT/bin/tuner" || fail "refused: the screen's tuner"
+k_screen=$(cat "$OUT/k/full.k")
+k_landing=$(k_of "$OUT/bin/tuner" k_landing) || fail "the landing's K probe failed"
+[[ "$k_landing" == "$k_screen" ]] ||
+  fail "refused: the screen's tuner reads K $k_landing, and OUT/k/full.k holds $k_screen"
+k_cand=$(k_of "$root/build-tune/tools/tuner" k_candidate) || fail "the candidate's K probe failed"
+[[ -n "$k_cand" ]] || fail "the candidate's K probe printed no K"
+echo "K at the landing's constants (the screen's): $k_screen, reproduced by the screen's tuner"
+echo "K refit at the candidate's constants (1245 at $MARGIN): $k_cand, one round (constants fixed)"
+echo "corpus $corpus, 40-step ternary search on its training rows; read on $holdout"
+
+census_for() {
+  local tree="$1" bin
+  case "$tree" in
+    landing) bin="$OUT/bin/margin_census" ;;
+    p6|p7) bin=$(ls -d "$OUT"/variant_"$tree"_*/bin/margin_census | head -n 1) ;;
+    *) die "no census for tree $tree" ;;
+  esac
+  check_copy "$bin"
+  echo "$bin"
+}
+
+# mse of one vector (or the landing's shipped constants, "start") at one K.
+mse() {
+  local dir="$1" k="$2" tag="$3" bin args=()
+  if [[ "$dir" == start ]]; then
+    bin=$(census_for landing) || exit 1
+  else
+    bin=$(census_for "$(cat "$dir/tree.txt")") || exit 1
+    args=(--vector "$dir/full.vector")
+  fi
+  "$bin" --data "$holdout" "${args[@]}" --k "$k" --loss-margin "$MARGIN" \
+      --games "$WORK/$tag.games" --threads 12 > "$WORK/$tag.census" 2>&1 ||
+    die "margin_census failed on $dir: $WORK/$tag.census"
+  awk '!/^#/ { rows += $3; sse += $4 } END { printf "%.10f\n", sse / rows }' "$WORK/$tag.games"
+}
+
+stop=0
+printf '\n%-4s %-8s %-10s %-11s %-12s %-12s %-12s %s\n' part outcome m "screen d" "d at K scr" "d at K cand" "rows" ""
+for part in P1 P2 P3 P4 P5 P6 P7; do
+  reading="$OUT/read/$part.txt"
+  line=$(grep '^DECIDED ' "$reading") || fail "no DECIDED line in $reading"
+  fit=$(awk '{ print $3 }' <<< "$line")
+  pred=$(awk '{ print $5 }' <<< "$line")
+  dscreen=$(awk '{ print $7 }' <<< "$line")
+  m=$(sed -n 's/.* s [0-9.]*, m \([0-9.]*\),.*/\1/p' "$reading" | head -n 1)
+  outcome=dropped
+  [[ " $KEPT " == *" $part "* ]] && outcome=kept
+  ds=()
+  for k in "$k_screen" "$k_cand"; do
+    a=$(mse "$pred" "$k" "${part}_pred_$k") || fail "$part: the census of $pred failed"
+    b=$(mse "$fit" "$k" "${part}_fit_$k") || fail "$part: the census of $fit failed"
+    ds+=("$(awk -v a="$a" -v b="$b" 'BEGIN { printf "%+.7f", a - b }')")
+  done
+  rows=$(awk '!/^#/ { r += $3 } END { print r }' "$WORK/${part}_fit_$k_cand.games")
+  flag=""
+  if [[ "$outcome" == kept ]]; then
+    if awk -v d="${ds[1]}" -v m="$m" -v s="$dscreen" \
+         'BEGIN { exit !(d <= m || (d > 0) != (s > 0)) }'; then
+      flag="STOP"; stop=1
+    fi
+  else
+    flag="(a reading)"
+  fi
+  printf '%-4s %-8s %-10s %-11s %-12s %-12s %-12s %s\n' "$part" "$outcome" "$m" "$dscreen" "${ds[0]}" "${ds[1]}" "$rows" "$flag"
+done
+
+if (( stop )); then
+  echo "STOP: a part DEC-353 keeps reads at or under its m, or turns sign, at K refit at the candidate; the coordinator's before any SPRT"
+  echo "S122-KCHECK-STOP"
+  exit 1
+fi
+echo "S122-KCHECK-DONE"
