+bool load_rows(const std::vector<std::string>& fens, dataset_t* data)
+{
+  const std::string path =
+      (std::filesystem::temp_directory_path() / "chesso_S122_clampread.tsv").string();
+  if (!write_rows(path, fens)) { return false; }
+  tuner_trace::load_report_t report;
+  std::string error;
+  const bool ok = tuner_trace::load(path, data, &report, &error, 1) && report.mismatches == 0;
+  std::remove(path.c_str());
+  return ok;
