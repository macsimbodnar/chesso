+      };
+
+      const std::string where = "ply " + std::to_string(ply);
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, root);
+      const hash_t two = back(2) * codes + back(1);
+      const hash_t four = back(4) * codes + back(1);
+
+      CHECK_MESSAGE(keys.by_offset[0] == two, where);
+      CHECK_MESSAGE(keys.by_offset[1] == four, where);
+
+      // The search's read at this ply: the two written-out slots planted,
+      // every other slot empty.
+      const color_t stm = game.board.active_color;
+
+      correction_reset(&continuation_table);
+      cc_slot(continuation_table, 0, stm, two) = 20 * CORRHIST_GRAIN;
+      cc_slot(continuation_table, 1, stm, four) = 40 * CORRHIST_GRAIN;
+
+      const int raw = evaluate(&game.board);
+
+      CHECK_MESSAGE(search_corrected_eval_game_probe(&state, &game, raw) ==
+                        raw + numerator / denominator,
+                    where);
+
+      if (ply == 4) { break; }
+
+      const std::vector<move_t> next = play_first_moves(1);
+
+      REQUIRE(next.size() == 1);
+      below.push_back(continuation_move_code(next[0]));
+      REQUIRE(below.back() != 0);
+    }
+  }
+
+
+  // THE NULL MOVE, the accepts' own: the history entry make_null_move()
+  // pushes carries move 0, and the keys read it as no move -- the sentinel
+  // -- and never as the white pawn arriving on a8 that move 0 decodes to.
+  // One move below the root, a null move, then three more moves: the null
+  // move is read one ply, two plies and four plies above a node, and at each
+  // the sentinel stands in its place while the moves around it keep their
+  // codes.
+  //
+  // Mutation: CC05_null_move_decoded.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "a null move is read as no move by the continuation keys")
+  {
+    load(DEFAULT_POSITION);
+
+    const size_t root = game.history.size;
+    const size_t codes = CORRHIST_CONT_MOVE_CODES;
+
+    // The precondition: move 0 decodes to a real move's fields.
+    REQUIRE(MOVE_PIECE(0) == W_PAWN);
+    REQUIRE(MOVE_TO(0) == a8);
+
+    const std::vector<move_t> first = play_first_moves(1);
+
+    REQUIRE(first.size() == 1);
+
+    make_null_move(&game);
+    REQUIRE(game.history.entries[game.history.size - 1].move == 0);
+
+    const size_t c0 = continuation_move_code(first[0]);
+    std::vector<size_t> after;
+
+    // Ply 2: the null move one ply up, the first move two plies up.
+    {
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, root);
+
+      CHECK_EQ(keys.by_offset[0], hash_t{c0 * codes});
+      CHECK_EQ(keys.by_offset[1], hash_t{0});
+    }
+
+    for (size_t i = 0; i < 3; ++i) {
+      const std::vector<move_t> next = play_first_moves(1);
+
+      REQUIRE(next.size() == 1);
+      after.push_back(continuation_move_code(next[0]));
+    }
+
+    // Plies 3 to 5 again, on the way back up: unmaking the last move each
+    // time leaves the history as the node at that ply sees it.
+    {
+      // Ply 5: the null move four plies up.
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, root);
+
+      CHECK_EQ(keys.by_offset[0], hash_t{after[1] * codes + after[2]});
+      CHECK_EQ(keys.by_offset[1], hash_t{after[2]});
+    }
+
+    unmake_move(&game);
+
+    {
+      // Ply 4: the first move four plies up, real again.
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, root);
+
+      CHECK_EQ(keys.by_offset[0], hash_t{after[0] * codes + after[1]});
+      CHECK_EQ(keys.by_offset[1], hash_t{c0 * codes + after[1]});
+    }
+
+    unmake_move(&game);
+
+    {
+      // Ply 3: the null move two plies up.
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, root);
+
+      CHECK_EQ(keys.by_offset[0], hash_t{after[0]});
+      CHECK_EQ(keys.by_offset[1], hash_t{after[0]});
+    }
+  }
+
+
+  // THE IDENTITY, DEC-215's off value on the blend: at both continuation
+  // weights 0 the blend is the pawn read to the unit, whatever the
+  // continuation reads are -- the parent's correction, the pawn table alone.
+  // The integer form: n = 200 * pawn + 2 * (w2 * two + w4 * four), d = 200 +
+  // 2 * (w2 + w4), the result |n| + d / 2 over d, truncated, with n's sign; at
+  // w2 = w4 = 0 that is |200 * pawn| + 100 over 200, which truncates to
+  // |pawn| for every integer pawn. Every pawn read the table can give, and
+  // well past it, against continuation reads of both signs and at the clamp.
+  //
+  // Mutation: CC11_blend_ignores_continuation_weights.
+  TEST_CASE("at both continuation weights 0 the blend is the pawn read")
+  {
+    const std::vector<continuation_reads_t> reads = {
+        {{0, 0}},
+        {{CORRHIST_MAX, -CORRHIST_MAX}},
+        {{-CORRHIST_MAX, 23}},
+        {{11, CORRHIST_MAX}},
+        {{CORRHIST_MAX, CORRHIST_MAX}}};
+
+    size_t checked = 0;
+
+    for (int pawn = -2 * CORRHIST_MAX; pawn <= 2 * CORRHIST_MAX; ++pawn) {
+      for (const continuation_reads_t& continuation : reads) {
+        REQUIRE_EQ(correction_blend(pawn, continuation, 0, 0), pawn);
+        ++checked;
+      }
+    }
+
+    REQUIRE(checked > 100);
+  }
+
+
+  // THE BLEND WITH THE CONTINUATION READS, as the pure function the search
+  // calls, at weights the release build does not ship as well as at its own:
+  // the pawn read at 100 and each continuation read at its own weight, one
+  // division, rounded half away from zero. Every expectation is the
+  // arithmetic written out here, not read from the engine.
+  //
+  // Mutation: CC10_four_ply_at_two_ply_weight,
+  // CC11_blend_ignores_continuation_weights, CC12_shares_drop_continuation,
+  // CC13_continuation_not_doubled, CC23_blend_rounds_toward_floor.
+  TEST_CASE("the blend weighs each continuation read at its own weight")
+  {
+    // Beside a pawn read of 10, a read of 40 at 100: (10 + 40) / 2 = 25,
+    // whichever table it is.
+    CHECK_EQ(correction_blend(10, {{40, 0}}, 100, 0), 25);
+    CHECK_EQ(correction_blend(10, {{0, 40}}, 0, 100), 25);
+
+    // Alone beside an empty pawn read, 30 at 100 is 15, at 50 a third, 10,
+    // and at 200 two thirds, 20.
+    CHECK_EQ(correction_blend(0, {{30, 0}}, 100, 0), 15);
+    CHECK_EQ(correction_blend(0, {{30, 0}}, 50, 0), 10);
+    CHECK_EQ(correction_blend(0, {{30, 0}}, 200, 0), 20);
+    CHECK_EQ(correction_blend(0, {{0, 30}}, 0, 50), 10);
+
+    // A read at weight 0 is not in the average, the other one is.
+    CHECK_EQ(correction_blend(0, {{30, 60}}, 100, 0), 15);
+    CHECK_EQ(correction_blend(0, {{60, 30}}, 0, 100), 15);
+
+    // Each read at its own weight and not the other's: (50 * 30 + 200 * 60)
+    // / 350 = 38.6, rounded to 39, and the reads swapped, (50 * 60 + 200 *
+    // 30) / 350 = 25.7, rounded to 26.
+    CHECK_EQ(correction_blend(0, {{30, 60}}, 50, 200), 39);
+    CHECK_EQ(correction_blend(0, {{60, 30}}, 50, 200), 26);
+
+    // The seeds: the pawn read and each continuation read a third each.
+    // (30 + 0 + 0) / 3 = 10, (0 + 30 + 30) / 3 = 20, and (10 + 40 + 50) / 3
+    // = 33.3, rounded to 33.
+    CHECK_EQ(correction_blend(30, {{0, 0}}, 100, 100), 10);
+    CHECK_EQ(correction_blend(0, {{30, 30}}, 100, 100), 20);
+    CHECK_EQ(correction_blend(10, {{40, 50}}, 100, 100), 33);
+
+    // The rounding: a half away from 0, a quarter or a third to 0, either
+    // sign: 1 / 2, 1 / 4 at (100, 200) and 1 / 3 at the seeds.
+    CHECK_EQ(correction_blend(0, {{1, 0}}, 100, 0), 1);
+    CHECK_EQ(correction_blend(0, {{-1, 0}}, 100, 0), -1);
+    CHECK_EQ(correction_blend(0, {{1, 0}}, 100, 200), 0);
+    CHECK_EQ(correction_blend(0, {{-1, 0}}, 100, 200), 0);
+    CHECK_EQ(correction_blend(1, {{0, 0}}, 100, 100), 0);
+    CHECK_EQ(correction_blend(-1, {{0, 0}}, 100, 100), 0);
+    CHECK_EQ(correction_blend(-1, {{-1, 0}}, 100, 0), -1);
+
+    // An average: saturated reads of one sign average to themselves at every
+    // weight, so the three reads together never pass CorrHistMax.
+    for (const int two : {0, 50, 100, 200}) {
+      for (const int four : {0, 50, 100, 200}) {
+        const int top = CORRHIST_MAX;
+
+        CHECK_EQ(correction_blend(top, {{top, top}}, two, four), top);
+        CHECK_EQ(correction_blend(-top, {{-top, -top}}, two, four), -top);
+      }
+    }
+
+    // Never outside the three reads it averages, and sign-symmetric, which
+    // is what a position and its mirror need of it (INV-5).
+    for (int pawn = -CORRHIST_MAX; pawn <= CORRHIST_MAX; pawn += 7) {
+      for (int c2 = -CORRHIST_MAX; c2 <= CORRHIST_MAX; c2 += 11) {
+        for (int c4 = -CORRHIST_MAX; c4 <= CORRHIST_MAX; c4 += 13) {
+          const int low = std::min({pawn, c2, c4});
+          const int high = std::max({pawn, c2, c4});
+
+          for (const int two : {0, 37, 100, 163, 200}) {
+            for (const int four : {0, 37, 100, 163, 200}) {
+              const int blended = correction_blend(pawn, {{c2, c4}}, two, four);
+
+              REQUIRE(blended >= low);
+              REQUIRE(blended <= high);
+              REQUIRE_EQ(correction_blend(-pawn, {{-c2, -c4}}, two, four),
+                         -blended);
+            }
+          }
+        }
+      }
+    }
+  }
+
+
+  // THE ACCEPTS' BOUND with every table saturated, the continuation tables
+  // included: the pawn table and both continuation tables planted in every
+  // slot at the largest entry an update can write, either sign, and at
+  // entries no update can write. The corrected score stays strictly inside
+  // the mate band at raw scores up to and past its edge, and away from the
+  // edge it is the raw score plus the blend written out, its rounding too.
+  //
+  // The plants of one sign blend to CorrHistMax and no more, an average. The
+  // two with the continuation tables against the pawn table are what show
+  // the continuation reads are live: there the blend is a third of
+  // CorrHistMax the other way at the seeds, where the pawn read alone would
+  // be CorrHistMax. The positive half is checked
+  // against its own precondition: at a raw score ten under the band's edge
+  // the planted correction alone would carry the sum into the band, so a
+  // result outside it is the clamp's.
+  //
+  // Mutation: CH01_mate_clamp_dropped, CC09_continuation_not_applied,
+  // CC12_shares_drop_continuation, CC20_continuation_read_unclamped.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "a corrected score never reaches the mate band with every "
+                    "continuation table saturated")
+  {
+    load(DEFAULT_POSITION);
+
+    REQUIRE(CORRHIST_MAX > 10);
+
+    const std::vector<int> raws = {0,
+                                   1,
+                                   -1,
+                                   1000,
+                                   -1000,
+                                   22945,
+                                   -22945,
+                                   32767,
+                                   -32767,
+                                   CC_MATE_MIN - 10,
+                                   -(CC_MATE_MIN - 10),
+                                   CC_MATE_MIN - 1,
+                                   -(CC_MATE_MIN - 1),
+                                   CC_MATE_MIN,
+                                   -CC_MATE_MIN,
+                                   CC_MATE_MAX,
+                                   -CC_MATE_MAX};
+
+    // (the pawn table's plant, both continuation tables').
+    //
+    // `over` is ten units past the entry bound: each read clamps it to
+    // CorrHistMax, and a read that skipped the clamp would apply ten more --
+    // CC20_continuation_read_unclamped is killed here, at the first two
+    // plants, by a wrong number and not by the signed overflow the int32
+    // extremes would put through an unclamped blend. They come first so the
+    // case stops on that number before any extreme is planted.
+    const int32_t bound = cc_entry_bound();
+    const int32_t over = (CORRHIST_MAX + 10) * CORRHIST_GRAIN;
+    const int32_t top = std::numeric_limits<int32_t>::max();
+    const int32_t bottom = std::numeric_limits<int32_t>::min();
+    const std::vector<std::pair<int32_t, int32_t>> plants = {
+        {over, over}, {-over, -over},   {bound, bound},  {-bound, -bound},
+        {top, top},   {bottom, bottom}, {bound, -bound}, {-bound, bound}};
+
+    for (const auto& [board_plant, move_plant] : plants) {
+      cc_fill_all(board_plant);
+
+      for (auto& table : continuation_table.by_offset) {
+        for (auto& side : table.entries) {
+          for (int32_t& entry : side) {
+            entry = move_plant;
+          }
+        }
+      }
+
+      // What the three saturated tables apply, written out: each read is
+      // CorrHistMax in its plant's direction, the pawn read at 100 and each
+      // continuation read at its own weight, rounded half away from zero --
+      // the published rule written here, not called.
+      const int board_read = (board_plant > 0) ? CORRHIST_MAX : -CORRHIST_MAX;
+      const int move_read = (move_plant > 0) ? CORRHIST_MAX : -CORRHIST_MAX;
+      const int numerator =
+          200 * board_read +
+          2 * (CORRHIST_CONT2_WEIGHT + CORRHIST_CONT4_WEIGHT) * move_read;
+      const int denominator =
+          200 + 2 * (CORRHIST_CONT2_WEIGHT + CORRHIST_CONT4_WEIGHT);
+      const int total = (numerator >= 0)
+                            ? (numerator + denominator / 2) / denominator
+                            : -((-numerator + denominator / 2) / denominator);
+      const int at_zero = search_corrected_eval_game_probe(&state, &game, 0);
+      const std::string plant_title =
+          "pawn entries " + std::to_string(board_plant) +
+          ", continuation entries " + std::to_string(move_plant);
+
+      REQUIRE_MESSAGE(at_zero == total, plant_title);
+      REQUIRE_MESSAGE(std::abs(at_zero) <= CORRHIST_MAX, plant_title);
+
+      if ((board_plant > 0) == (move_plant > 0)) {
+        REQUIRE_MESSAGE(std::abs(at_zero) == CORRHIST_MAX, plant_title);
+        REQUIRE(CC_MATE_MIN - 10 + std::abs(total) >= CC_MATE_MIN);
+      } else {
+        // The continuation reads are applied: the pawn read alone would be
+        // here.
+        REQUIRE_MESSAGE(at_zero != board_read, plant_title);
+      }
+
+      for (const int raw : raws) {
+        const int corrected =
+            search_corrected_eval_game_probe(&state, &game, raw);
+        const std::string title = "raw " + std::to_string(raw) + ", " +
+                                  plant_title + ", corrected " +
+                                  std::to_string(corrected);
+
+        REQUIRE_MESSAGE(corrected < CC_MATE_MIN, title);
+        REQUIRE_MESSAGE(corrected > -CC_MATE_MIN, title);
+
+        if (std::abs(raw) < CC_MATE_MIN - 1 - CORRHIST_MAX) {
+          REQUIRE_MESSAGE(corrected - raw == total, title);
+        }
+      }
+    }
+  }
+
+
+  // Each continuation table is read at its own key and for the side to move,
+  // and nothing else is read. Four moves are played below the root, so both
+  // keys are built on moves; the node's two slots are planted, and every
+  // slot a wrong read would land in -- the other side to move's at all four
+  // keys in both tables, each table at the other table's key, and each key
+  // with its two moves the other way round -- with a value that would show.
+  // The precondition is that the four keys are distinct, without which a
+  // mix-up reads the same slot; a position where the generator's moves leave
+  // two of them equal is skipped, and at least one must not be.
+  //
+  // Mutation: CC07_read_tables_crossed, CC08_read_side_flipped,
+  // CC09_continuation_not_applied, CC21_read_at_root_keys.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "each continuation table is read at its own key")
+  {
+    const size_t codes = CORRHIST_CONT_MOVE_CODES;
+    size_t checked = 0;
+
+    for (const std::string& fen :
+         {std::string(DEFAULT_POSITION), std::string(KIWIPETE_POS)}) {
+      load(fen);
+
+      if (play_first_moves(4).size() != 4) { continue; }
+
+      const continuation_keys_t keys =
+          continuation_correction_keys(&game.history, state.root_history_size);
+      const hash_t two = keys.by_offset[0];
+      const hash_t four = keys.by_offset[1];
+      const hash_t two_swapped = (two % codes) * codes + two / codes;
+      const hash_t four_swapped = (four % codes) * codes + four / codes;
+      const std::vector<hash_t> all = {two, four, two_swapped, four_swapped};
+      bool distinct = true;
+
+      for (size_t i = 0; i < all.size(); ++i) {
+        for (size_t j = i + 1; j < all.size(); ++j) {
+          if (all[i] == all[j]) { distinct = false; }
+        }
+      }
+
+      if (!distinct) { continue; }
+
+      const color_t stm = game.board.active_color;
+      const color_t other = !stm;
+
+      // The decoys first, then the two slots the node must read.
+      for (size_t offset = 0; offset < 2; ++offset) {
+        for (const hash_t key : all) {
+          cc_slot(continuation_table, offset, other, key) =
+              -40 * CORRHIST_GRAIN;
+          cc_slot(continuation_table, offset, stm, key) = -30 * CORRHIST_GRAIN;
+        }
+      }
+
+      cc_slot(continuation_table, 0, stm, two) = 20 * CORRHIST_GRAIN;
+      cc_slot(continuation_table, 1, stm, four) = 40 * CORRHIST_GRAIN;
+
+      REQUIRE(CORRHIST_MAX >= 40);
+
+      // The blend written out, not called: 20 and 40 at their weights beside
+      // an empty pawn slot -- at the seeds (2 * (100 * 20 + 100 * 40)) / 600
+      // = 20. The reads are chosen so that no rounding enters.
+      const int raw = evaluate(&game.board);
+      const int numerator =
+          2 * (CORRHIST_CONT2_WEIGHT * 20 + CORRHIST_CONT4_WEIGHT * 40);
+      const int denominator =
+          200 + 2 * (CORRHIST_CONT2_WEIGHT + CORRHIST_CONT4_WEIGHT);
+
+      REQUIRE(numerator % denominator == 0);
+
+      const int expected = raw + numerator / denominator;
+
+      REQUIRE_NE(expected, raw);
+
+      CHECK_MESSAGE(
+          search_corrected_eval_game_probe(&state, &game, raw) == expected,
+          ("FEN: " + fen));
+
+      ++checked;
+    }
+
+    REQUIRE(checked > 0);
+  }
+
+
+  // THE SITE AGAINST THE GATE, for the continuation tables: S099's case "the
+  // search teaches the table exactly where the gate does" with the
+  // continuation tables attached beside an empty pawn table, and the node
+  // one to four moves below the root so its keys are built on moves. Every
+  // third test position, three windows, a PV node at depth one, so each bound
+  // type is stored and each side of the raw score reached; the node's children
+  // are quiescence, which reads and writes no table, so the node is the only
+  // writer. Both of the node's slots start at ten units, alternately raised and
+  // lowered, so the node reads a corrected score seven from its raw one at the
+  // seeds -- two reads of ten averaged with the empty pawn slot, 6.7 rounded: a
+  // site that learned from the corrected score, or stored it, disagrees with
+  // the reference by those seven units. Each table must then hold exactly the
+  // published update of `returned - raw` at depth 1 at its own key where the
+  // gate teaches, the plant where it does not, and nothing anywhere else.
+  //
+  // Which positions are in check, which best moves are captures and which
+  // scores fall where is the engine's answer; the floors at the bottom are
+  // what make the case non-vacuous.
+  //
+  // Mutation: CC14_continuation_gate_dropped,
+  // CC15_continuation_update_sign_flipped, CC16_continuation_learns_corrected,
+  // CC17_update_crosses_the_tables, CC22_update_at_root_keys.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "the search teaches the continuation tables exactly where "
+                    "the gate does")
+  {
+    load(DEFAULT_POSITION);
+    correction_reset(&continuation_reference);
+
+    size_t driven = 0;
+    size_t taught_moved = 0;
+    size_t refused = 0;
+    size_t refused_in_check = 0;
+    size_t distinct_keys = 0;
+
+    const std::vector<std::string>& fens = all_test_fens();
+
+    for (size_t f = 0; f < fens.size(); f += 3) {
+      for (int window = 0; window < 3; ++window) {
+        REQUIRE_MESSAGE(load_FEN(fens[f], &game), ("FEN: " + fens[f]));
+
+        const size_t turn = f / 3 + static_cast<size_t>(window);
+
+        state.root_history_size = game.history.size;
+
+        const std::vector<move_t> line = play_first_moves(1 + turn % 4);
+
+        if (line.empty()) { continue; }
+
+        const size_t ply = line.size();
+
+        tt_new_search(&tt);
+        correction_reset(&correction_table);
+        state.explored_nodes = 0;
+
+        const continuation_keys_t keys = continuation_correction_keys(
+            &game.history, state.root_history_size);
+        const color_t stm = game.board.active_color;
+        const int32_t plant = ((turn % 2 == 0) ? 10 : -10) * CORRHIST_GRAIN;
+
+        REQUIRE_MESSAGE(cc_empty(continuation_table), ("FEN: " + fens[f]));
+
+        cc_slot(continuation_table, 0, stm, keys.by_offset[0]) = plant;
+        cc_slot(continuation_table, 1, stm, keys.by_offset[1]) = plant;
+
+        const bool in_check = is_check(&game);
+        const int raw = in_check ? TT_EVAL_NONE : evaluate(&game.board);
+        const int centre = in_check ? 0 : raw;
+
+        const int alpha = (window == 0)   ? -SEARCH_SCORE_INF
+                          : (window == 1) ? centre + 50
+                                          : centre - 51;
+        const int beta = (window == 0) ? SEARCH_SCORE_INF : alpha + 1;
+
+        const board_t before = game.board;
+
+        const int returned =
+            negamax(alpha, beta, 1, ply, &game, &state, line.back(), true);
+
+        REQUIRE(!state.aborted);
+        REQUIRE(std::memcmp(&before, &game.board, sizeof(board_t)) == 0);
+
+        const std::string where = "FEN " + fens[f] + ", window " +
+                                  std::to_string(window) + ", ply " +
+                                  std::to_string(ply);
+
+        // What the reference says the two slots hold: the plant, and the
+        // published update of it where the node stored and the gate teaches.
+        cc_slot(continuation_reference, 0, stm, keys.by_offset[0]) = plant;
+        cc_slot(continuation_reference, 1, stm, keys.by_offset[1]) = plant;
+
+        // No store by this drive: nothing may have been learned.
+        const tt_entry_t* stored = tt_get_entry(&tt, &game.board);
+        const bool node_stored = stored != nullptr && stored->depth == 1 &&
+                                 stored->generation == tt.generation;
+
+        if (node_stored) {
+          ++driven;
+
+          if (keys.by_offset[0] != keys.by_offset[1]) { ++distinct_keys; }
+
+          // The node read both plants -- the corrected score on its stack
+          // slot is the blend of an empty pawn slot and two plants of ten --
+          // and stored the raw score.
+          if (!in_check) {
+            const int read = plant / CORRHIST_GRAIN;
+            const int corrected =
+                raw + correction_blend(0, {{read, read}}, CORRHIST_CONT2_WEIGHT,
+                                       CORRHIST_CONT4_WEIGHT);
+
+            REQUIRE_NE(corrected, raw);
+            REQUIRE_MESSAGE(state.static_evals[ply] == corrected, where);
+            CHECK_MESSAGE(static_cast<int>(stored->eval) == raw, where);
+          }
+
+          const move_t best = stored->best_move;
+          const node_type_t type = static_cast<node_type_t>(stored->type);
+          const bool teaches = search_correction_may_learn_probe(
+              in_check, raw, best, type, returned);
+
+          if (teaches) {
+            continuation_correction_update(&continuation_reference, stm, keys,
+                                           returned - raw, 1);
+
+            if (cc_slot(continuation_reference, 0, stm, keys.by_offset[0]) !=
+                plant) {
+              ++taught_moved;
+            }
+          } else {
+            ++refused;
+            if (in_check) { ++refused_in_check; }
+          }
+        }
+
+        for (size_t offset = 0; offset < 2; ++offset) {
+          const hash_t key = keys.by_offset[offset];
+
+          REQUIRE_MESSAGE(cc_slot(continuation_table, offset, stm, key) ==
+                              cc_slot(continuation_reference, offset, stm, key),
+                          where);
+
+          // And nothing else: the reference wrote the node's two slots too.
+          cc_slot(continuation_table, offset, stm, key) = 0;
+          cc_slot(continuation_reference, offset, stm, key) = 0;
+        }
+
+        REQUIRE_MESSAGE(cc_empty(continuation_table), where);
+      }
+    }
+
+    MESSAGE("continuation site census: "
+            << driven << " stores, " << taught_moved << " taught a moved slot, "
+            << refused << " refused (" << refused_in_check << " in check), "
+            << distinct_keys << " with the two keys distinct");
+
+    // Each path at least once; floors of one are the property's own
+    // non-vacuity, not goldens. A refusal out of check is the one CC14 can
+    // be seen at: its ungated update still refuses the in-check sentinel. No
+    // floor on the in-check refusals
+    // themselves: whether the generator's first moves leave a node in check
+    // is the engine's answer, and the gate case holds that clause directly.
+    REQUIRE(taught_moved > 0);
+    REQUIRE(refused > refused_in_check);
+    REQUIRE(distinct_keys > 0);
+  }
+
+
+  // The step's Hazard, re-run with all three tables: "pruning does not hide a
+  // forced mate"'s mate-in-two rows, as S099's "the correction table hides no
+  // forced mate" holds them for the pawn table -- cold tables that learn as
+  // the search goes, and every slot of every table at the largest entry there
+  // is, raised and lowered. Below the root the search reads the continuation
+  // tables at keys built on its own moves. A red row here is a finding about
+  // the correction and the pruning rules together, for the owner, and never
+  // a reason to relax the row.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "the continuation tables hide no forced mate")
+  {
+    const std::vector<std::string> rows = {
+        MATE_IN_2_W_POS, MATE_IN_2_B_POS,
+        "6qk/7p/2p2p1B/4R2P/4P1Q1/1p4P1/5P2/6K1 w - - 1 43"};
+
+    const std::vector<int32_t> starts = {0, cc_entry_bound(),
+                                         -cc_entry_bound()};
+
+    for (const int32_t start : starts) {
+      for (const std::string& row : rows) {
+        for (int depth = 3; depth <= 6; ++depth) {
+          load(row);
+          cc_fill_all(start);
+
+          // The planted start is what the root reads.
+          const int raw = evaluate(&game.board);
+          const int read = start / CORRHIST_GRAIN;
+
+          REQUIRE_EQ(search_corrected_eval_game_probe(&state, &game, raw),
+                     raw + correction_blend(read, {{read, read}},
+                                            CORRHIST_CONT2_WEIGHT,
+                                            CORRHIST_CONT4_WEIGHT));
+
+          const search_t result = search(depth, &game, &state);
+          const std::string title = row + ", depth " + std::to_string(depth) +
+                                    ", start " + std::to_string(start);
+
+          REQUIRE_MESSAGE(result.mate_found, title);
+          REQUIRE_MESSAGE(result.mate_in == 2, title);
+        }
+      }
+    }
+  }
+
+
+#ifdef CHESSO_TUNE
+  // DEC-215's off value on the tree's own read, tune build only, where the
+  // weights are variables: at CorrHistCont2Weight and CorrHistCont4Weight 0
+  // saturated continuation tables add nothing, and the corrected score is
+  // the parent's -- the pawn read alone.
+  // The preconditions are the same tables at the shipped weights moving it,
+  // and one weight at 0 not enough. The bench stream at 0 and 0 equal to the
+  // parent's is the step file's record of the same property on a whole
+  // search.
+  TEST_CASE_FIXTURE(continuation_fixture_t,
+                    "at both continuation weights 0 the continuation tables "
+                    "add nothing")
+  {
+    load(KIWIPETE_POS);
+
+    // Puts back the values it found, the queen-promotion switch's pattern: a
+    // failed assertion must not leave a weight at 0 for every case after.
+    const int found_two = CORRHIST_CONT2_WEIGHT;
+    const int found_four = CORRHIST_CONT4_WEIGHT;
+
+    struct restore_t
+    {
+      int two;
+      int four;
+      ~restore_t()
+      {
+        search_param_set("CorrHistCont2Weight", two);
+        search_param_set("CorrHistCont4Weight", four);
+      }
+    } restore{found_two, found_four};
+
+    for (auto& table : continuation_table.by_offset) {
+      for (auto& side : table.entries) {
+        for (int32_t& entry : side) {
+          entry = cc_entry_bound();
+        }
+      }
+    }
+
+    correction_table
+        .entries[game.board.active_color]
+                [correction_slot<CORRHIST_PAWN_ENTRIES>(game.board.pawn_hash)] =
+        5 * CORRHIST_GRAIN;
+
+    const int raw = evaluate(&game.board);
+    const int parent = raw + 5;
+
+    REQUIRE(found_two > 0);
+    REQUIRE(found_four > 0);
+    REQUIRE_NE(search_corrected_eval_game_probe(&state, &game, raw), parent);
+
+    REQUIRE(search_param_set("CorrHistCont2Weight", 0));
+    REQUIRE_NE(search_corrected_eval_game_probe(&state, &game, raw), parent);
+
+    REQUIRE(search_param_set("CorrHistCont4Weight", 0));
+    CHECK_EQ(search_corrected_eval_game_probe(&state, &game, raw), parent);
+
+    REQUIRE(search_param_set("CorrHistCont2Weight", found_two));
+    REQUIRE(search_param_set("CorrHistCont4Weight", found_four));
+    REQUIRE_EQ(CORRHIST_CONT2_WEIGHT, found_two);
+    REQUIRE_EQ(CORRHIST_CONT4_WEIGHT, found_four);
+  }
+#endif
+}
