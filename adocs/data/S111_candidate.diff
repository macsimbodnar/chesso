diff --git a/tools/mutants/S111_continuation_correction.py b/tools/mutants/S111_continuation_correction.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b30c511d4fbcf42eb24ed222b1078f0cee8c6d7
--- /dev/null
+++ b/tools/mutants/S111_continuation_correction.py
@@ -0,0 +1,322 @@
+"""The two continuation correction tables, S111.
+
+Twenty-five mutants over the tables' key, sentinels, read, blend, update
+and ownership, one per rule the step adds. The mate band's clamp is the pawn
+table's line and stays CH01's (tools/mutants/S099_correction_history.py);
+"a corrected score never reaches the mate band with every continuation table
+saturated" names it as well, so the accepts' bound is killed with all three
+tables live. Written on S110's tree and rebased onto its revert (S110's H0,
+`eee722c`): the blend is the pawn read's and the two continuation reads'
+alone, and S110's re-anchored NC01 and NC14 left with S110.
+
+    CC01..CC04  the key: the move one ply ago left out, the two-ply and
+                four-ply moves read three plies back, and the root's guard
+                dropped so a game's moves before the root are read
+    CC05, CC06  the code: move 0 -- no move, and the null move -- decoded as
+                a white pawn arriving on a8, and the piece's colour kept so
+                a code leaves its range
+    CC07, CC08  the read: each table at the other's key, and for the side
+                not to move
+    CC20        the read past CorrHistMax: the entry over the grain without
+                correction_value()'s clamp
+    CC21        the read site at the root's keys whatever the ply
+    CC09        the continuation reads never applied: the blend computed
+                and dropped
+    CC10..CC13  the blend: the four-ply read at the two-ply weight, the
+                continuation weights ignored, the denominator without the
+                continuation weights, and their terms not in the blend's
+                doubled unit
+    CC23        the blend's rounding not symmetric in sign
+    CC14..CC17  the update: ungated, its difference negated or taken from the
+                corrected score, the two-ply table taught at the four-ply key
+    CC22        the update site at the root's keys whatever the ply
+    CC18, CC19  the UCI layer: `ucinewgame` leaving the tables warm, and the
+                tables never attached to a search
+    CC24, CC25  the UCI layer's other two clears: `test` before each of its
+                positions, and uci_init()
+
+**CC10 and CC11 change no number at the seeds' equal weights**, 100 and
+100, so no search can see them; they are killed by the pure blend's cases,
+which hold the weights at values the build does not ship: "the blend weighs
+each continuation read at its own weight" and "at both continuation weights 0
+the blend is the pawn read". CC13 is not of that kind: it halves both
+continuation weights in the numerator, so it moves the search at the seeds
+too, and the engine-level cases ("the continuation keys are defined at every
+ply from the root", "each continuation table is read at its own key", the
+saturated mate-band case) kill it beside the blend case.
+
+Which case is meant to kill each is named at the case, under "Mutation:", and
+here; the cases are tests/test_search.cpp's suite "search: continuation
+correction history" unless named otherwise:
+
+  CC01-CC04, CC21  "the continuation keys are defined at every ply from the
+                   root"; CC21 also "each continuation table is read at its
+                   own key"
+  CC05             "a move's continuation code is its piece type and
+                   destination", "the continuation keys are defined at every
+                   ply from the root", "a null move is read as no move by
+                   the continuation keys"
+  CC06             "a move's continuation code is its piece type and
+                   destination"
+  CC07, CC08       "each continuation table is read at its own key"
+  CC09             that case and "a corrected score never reaches the mate
+                   band with every continuation table saturated"
+  CC10, CC13, CC23 "the blend weighs each continuation read at its own
+                   weight"
+  CC11             "at both continuation weights 0 the blend is the pawn
+                   read", and the blend case
+  CC12, CC20       "a corrected score never reaches the mate band with every
+                   continuation table saturated"; CC12 also the blend case
+  CC14-CC17, CC22  "the search teaches the continuation tables exactly where
+                   the gate does"
+  CC18, CC19       tests/test_engine.cpp, "ucinewgame clears the
+                   continuation correction tables"
+  CC24             tests/test_engine.cpp, "a repeated test reads the same
+                   total" (S271's case)
+  CC25             tests/test_engine.cpp, "uci_init clears the continuation
+                   correction tables"
+  the mate band    CH01_mate_clamp_dropped, S099's, named by the saturated
+                   case as well
+
+The list is data: `m` is bound by tools/mutation_check.py, which execs this
+file. `old` must occur exactly once in `file`; `expected` is "killed".
+
+Prefix CC is new: `git log --all -p -- tools/mutants` shows AW, B, C, CH, CX,
+D, E, F, G, GC, H, I, J, K, L, LQ, LW, M, MW, N, NB, NC, NG, NK, NT, P, PD,
+PK, Q, R, RZ, S, T, TC, U, V, W, X, Y and Z, and no CC.
+"""
+
+S = "src/search.cpp"
+H = "src/correction_history.hpp"
+C = "src/chesso.cpp"
+
+
+m("CC01_key_drops_last_move", H, "search/correction",
+  'each key is the earlier move alone, without the move one ply ago, so the '
+  'tables are last-move tables two and four plies back and not the '
+  'continuation pair the step describes',
+  ("  return {{two * CORRHIST_CONT_MOVE_CODES + last,\n"
+   "           four * CORRHIST_CONT_MOVE_CODES + last}};\n",
+   "  (void)last;\n"
+   "  return {{two * CORRHIST_CONT_MOVE_CODES, four * CORRHIST_CONT_MOVE_CODES}};\n"),
+  origin="S111")
+
+m("CC02_two_ply_key_reads_three", H, "search/correction",
+  'the two-ply key reads the move three plies back, the opponent\'s, so the '
+  'table is keyed on the wrong move and the side to move no longer says '
+  'whose move it was',
+  ("      continuation_move_code(continuation_move(history, root_history_size, 2));\n",
+   "      continuation_move_code(continuation_move(history, root_history_size, 3));\n"),
+  origin="S111")
+
+m("CC03_four_ply_key_reads_three", H, "search/correction",
+  'the four-ply key reads the move three plies back, the opponent\'s',
+  ("      continuation_move_code(continuation_move(history, root_history_size, 4));\n",
+   "      continuation_move_code(continuation_move(history, root_history_size, 3));\n"),
+  origin="S111")
+
+m("CC04_sentinel_reads_before_root", H, "search/correction",
+  'the root\'s guard dropped: a node near the root reads the moves a game '
+  'played before the search began, so the search depends on how its '
+  'position was reached and plies 0 to 3 index no sentinel',
+  ("  if (history->size < plies || history->size - plies < root_history_size) {\n",
+   "  (void)root_history_size;\n"
+   "  if (history->size < plies) {\n"),
+  origin="S111")
+
+m("CC05_null_move_decoded", H, "search/correction",
+  'move 0 is decoded as a move -- a white pawn arriving on a8 -- so a null '
+  'move, and every ply before the root, index a real slot shared with that '
+  'move instead of the sentinel: the garbage the accepts forbids',
+  ("  if (move == 0) { return 0; }\n",
+   ""),
+  origin="S111")
+
+m("CC06_code_keeps_colour", H, "search/correction",
+  'the code keeps the piece\'s colour, so a black move\'s code passes '
+  'CORRHIST_CONT_MOVE_CODES and its key wraps onto a slot another pair owns',
+  ("  const size_t type = static_cast<size_t>(MOVE_PIECE(move)) % 6;\n",
+   "  const size_t type = static_cast<size_t>(MOVE_PIECE(move));\n"),
+  origin="S111")
+
+m("CC07_read_tables_crossed", H, "search/correction",
+  'the two-ply table is read at the four-ply key, so what it learned about '
+  'one pair is never what it returns',
+  ("  return {{correction_value(&tables->by_offset[0], side, keys.by_offset[0]),\n",
+   "  return {{correction_value(&tables->by_offset[0], side, keys.by_offset[1]),\n"),
+  origin="S111")
+
+m("CC08_read_side_flipped", H, "search/correction",
+  'both continuation tables are read for the side not to move, so White\'s '
+  'learned error for a pair corrects Black\'s static score',
+  ("  return {{correction_value(&tables->by_offset[0], side, keys.by_offset[0]),\n"
+   "           correction_value(&tables->by_offset[1], side, keys.by_offset[1])}};\n",
+   "  return {{correction_value(&tables->by_offset[0], !side, keys.by_offset[0]),\n"
+   "           correction_value(&tables->by_offset[1], !side, keys.by_offset[1])}};\n"),
+  origin="S111")
+
+m("CC20_continuation_read_unclamped", H, "search/correction",
+  'the continuation reads skip correction_value()\'s clamp, so an entry past '
+  'CorrHistMax * CORRHIST_GRAIN -- a planted one, or a CorrHistMax lowered '
+  'over a warm table -- applies more than CorrHistMax. Killed by "a corrected '
+  'score never reaches the mate band with every continuation table '
+  'saturated" at its first plant, ten units past the entry bound, which '
+  'reads 57 where CorrHistMax holds 47 and overflows nothing; the int32 '
