+// where that ply is not in this search's tree. The entry at
+// `root_history_size` is the root's own move, so a move `plies` back exists
+// only while the history is at least `plies` above the root: at ply 0 none
+// does, at ply 1 the last one, and the four-ply move first at ply 4. The
+// moves a game played before the root are not the search's, and are never
+// read: a search does not depend on how its position was reached, and a
+// state that never set the root (SIZE_MAX) reads no move at all. A null move
+// answers 0 as well, its history entry's own move.
+inline move_t continuation_move(const history_t* history,
+                                size_t root_history_size,
+                                size_t plies)
+{
+  if (history->size < plies || history->size - plies < root_history_size) {
+    return 0;
