+#include "threat_core.hpp"
+#ifndef S101_VARIANT
+#define S101_VARIANT 0
+#endif
+// bits: 1 the nine lesser pairs, 2 hanging by five types, 4 king-only by four
+// types, 8 push threats by four victims, 16 the two minor-on-minor pairs;
+// 32 all of 15 from sets built again at every stage-one call; 64 the four
+// pawn-attacker pairs alone in stage one.
+static inline void s101_consume(score_t sum) { asm volatile("" : : "r"(sum)); }
+
+template <int bits>
+static inline void s101_terms(const board_t* b,
+                              const bb_t by[2][6],
+                              const bb_t nonking[2],
+                              const bb_t all[2])
+{
+  score_t sum = 0;
+  const bb_t occupied = b->occupancies[BOTH];
+  for (int c = 0; c < 2; ++c) {
+    const int e = 1 - c;
+    const int sign = (c == WHITE) ? 1 : -1;
+    const bb_t* enemy = &b->bitboards[(c == WHITE) ? B_PAWN : W_PAWN];
+    const bb_t* own = &b->bitboards[(c == WHITE) ? W_PAWN : B_PAWN];
+#ifdef S101_GATED
+    const bb_t s101_nonpawn = enemy[1] | enemy[2] | enemy[3] | enemy[4];
+#endif
+    if constexpr ((bits & 1) != 0) {
+      const bb_t pawn = by[c][0], kn = by[c][1], bi = by[c][2], ro = by[c][3];
+#ifdef S101_GATED
+      if ((pawn & s101_nonpawn) | ((kn | bi) & (enemy[3] | enemy[4])) | (ro & enemy[4]))
+#endif
+      {
+      sum += sign * count_bits(pawn & enemy[1]) * make_score(3, 5);
+      sum += sign * count_bits(pawn & enemy[2]) * make_score(5, 7);
+      sum += sign * count_bits(pawn & enemy[3]) * make_score(7, 9);
+      sum += sign * count_bits(pawn & enemy[4]) * make_score(9, 11);
+      sum += sign * count_bits(kn & enemy[3]) * make_score(11, 13);
+      sum += sign * count_bits(kn & enemy[4]) * make_score(13, 15);
+      sum += sign * count_bits(bi & enemy[3]) * make_score(15, 17);
+      sum += sign * count_bits(bi & enemy[4]) * make_score(17, 19);
+      sum += sign * count_bits(ro & enemy[4]) * make_score(19, 21);
+      }
+    }
+    if constexpr ((bits & 16) != 0) {
+      sum += sign * count_bits(by[c][1] & enemy[2]) * make_score(21, 23);
+      sum += sign * count_bits(by[c][2] & enemy[1]) * make_score(23, 25);
+    }
+    if constexpr ((bits & 2) != 0) {
+      const bb_t hit = nonking[c] & ~all[e];
+#ifdef S101_GATED
+      if (hit & (s101_nonpawn | enemy[0]))
+#endif
+      for (int v = 0; v < 5; ++v) {
+        sum += sign * count_bits(hit & enemy[v]) * make_score(3 + v, 5 + v);
+      }
+    }
+    if constexpr ((bits & 4) != 0) {
+      const bb_t hit = by[c][5] & ~nonking[c] & ~all[e];
+#ifdef S101_GATED
+      if (hit & (s101_nonpawn | enemy[0]))
+#endif
+      for (int v = 0; v < 4; ++v) {
+        sum += sign * count_bits(hit & enemy[v]) * make_score(5 + v, 3 + v);
+      }
+    }
+    if constexpr ((bits & 8) != 0) {
+      const bb_t empty = ~occupied;
+      const bb_t safe = ~by[e][0] & (~all[e] | all[c]);
+      const bb_t one = s101::single_push(c, own[0], empty);
+      const bb_t targets =
+          (one & safe) | (s101::double_push(c, one & ~by[e][0], empty) & safe);
+      const bb_t hit = s101::pawn_attacks_from(c, targets) & ~by[c][0];
+#ifdef S101_GATED
+      if (hit & s101_nonpawn)
+#endif
+      for (int v = 1; v < 5; ++v) {
+        sum += sign * count_bits(hit & enemy[v]) * make_score(7 + v, 9 + v);
+      }
+    }
+  }
+  s101_consume(sum);
+}
+
+// Every set, built again from nothing: what stage one would pay without moving
+// stage two's loop.
+static inline void s101_stage_one(const board_t* b)
+{
+#if (S101_VARIANT & 32) != 0
+  s101::sets_t s;
+  s101::build_sets(game_tables(), b, &s);
+  s101_terms<15>(b, s.by, s.nonking, s.all);
+#elif (S101_VARIANT & 64) != 0
+  score_t sum = 0;
+  for (int c = 0; c < 2; ++c) {
+    const bb_t pawns = b->bitboards[(c == WHITE) ? W_PAWN : B_PAWN];
+    const bb_t* enemy = &b->bitboards[(c == WHITE) ? B_PAWN : W_PAWN];
+    const bb_t pawn = s101::pawn_attacks_from(c, pawns);
+    const int sign = (c == WHITE) ? 1 : -1;
+    sum += sign * count_bits(pawn & enemy[1]) * make_score(3, 5);
+    sum += sign * count_bits(pawn & enemy[2]) * make_score(5, 7);
+    sum += sign * count_bits(pawn & enemy[3]) * make_score(7, 9);
+    sum += sign * count_bits(pawn & enemy[4]) * make_score(9, 11);
+  }
+  s101_consume(sum);
+#else
+  (void)b;
+#endif
+}
