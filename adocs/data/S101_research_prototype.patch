+#ifdef S101_CENSUS
+struct s101_census_t
+{
+  enum { SITES = 3, KINDS = 6 };
+  uint64_t calls[SITES] = {};
+  uint64_t stm[SITES][KINDS] = {};
+  uint64_t other[SITES][KINDS] = {};
+  uint64_t rows_stm[SITES][KINDS] = {};
+  uint64_t rows_other[SITES][KINDS] = {};
+  void note(int site, const board_t* b)
+  {
+    s101::sets_t s;
+    s101::build_sets(game_tables(), b, &s);
+    calls[site]++;
+    const int mover = b->active_color;
+    for (int c = 0; c < 2; ++c) {
+      const int e = 1 - c;
+      int k[KINDS] = {};
+      k[0] = count_bits(s.by[c][0] & (s.pieces[e][1] | s.pieces[e][2] | s.pieces[e][3] | s.pieces[e][4])) +
+             count_bits(s.by[c][1] & (s.pieces[e][3] | s.pieces[e][4])) +
+             count_bits(s.by[c][2] & (s.pieces[e][3] | s.pieces[e][4])) +
+             count_bits(s.by[c][3] & s.pieces[e][4]);
+      const bb_t hit = s.nonking[c] & ~s.all[e];
+      k[1] = count_bits(hit & (s.pieces[e][1] | s.pieces[e][2] | s.pieces[e][3] | s.pieces[e][4]));
+      k[2] = count_bits(hit & s.pieces[e][0]);
+      k[3] = count_bits(s.by[c][5] & ~s.nonking[c] & ~s.all[e] & (s.pieces[e][0] | s.pieces[e][1] | s.pieces[e][2] | s.pieces[e][3]));
+      const bb_t empty = ~b->occupancies[BOTH];
+      const bb_t safe = ~s.by[e][0] & (~s.all[e] | s.all[c]);
+      const bb_t one = s101::single_push(c, s.pieces[c][0], empty);
+      const bb_t targets = (one & safe) | (s101::double_push(c, one & ~s.by[e][0], empty) & safe);
+      k[4] = count_bits(s101::pawn_attacks_from(c, targets) & ~s.by[c][0] & (s.pieces[e][1] | s.pieces[e][2] | s.pieces[e][3] | s.pieces[e][4]));
+      k[5] = count_bits(s.by[c][1] & s.pieces[e][2]) + count_bits(s.by[c][2] & s.pieces[e][1]);
+      for (int i = 0; i < KINDS; ++i) {
+        (c == mover ? stm : other)[site][i] += k[i];
+        if (k[i]) { (c == mover ? rows_stm : rows_other)[site][i]++; }
+      }
+    }
+  }
+  ~s101_census_t()
+  {
+    const char* site[SITES] = {"search evaluate()", "lazy, every call", "lazy, past the shortcut"};
+    const char* kind[KINDS] = {"lesser9", "hanging NBRQ", "hanging P", "king-only PNBR", "push safe2", "minor on minor"};
+    for (int i = 0; i < SITES; ++i) {
+      fprintf(stderr, "site %-26s calls %llu\n", site[i], (unsigned long long)calls[i]);
+      for (int j = 0; j < KINDS; ++j) {
+        const double c = calls[i] ? double(calls[i]) : 1.0;
+        const double t = double(stm[i][j] + other[i][j]);
+        fprintf(stderr, "  %-16s attacker on move %.4f a call, not on move %.4f, share on move %.1f %%, calls with stm's %.2f %%, with other's %.2f %%\n",
+                kind[j], stm[i][j] / c, other[i][j] / c, t > 0 ? 100.0 * stm[i][j] / t : 0.0,
+                100.0 * rows_stm[i][j] / c, 100.0 * rows_other[i][j] / c);
+      }
+    }
+  }
+};
+static s101_census_t s101_census;
+#define S101_NOTE(site, board) s101_census.note(site, board)
+#else
+#define S101_NOTE(site, board) ((void)0)
+#endif
+
