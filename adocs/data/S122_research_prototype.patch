+#if (S122_VARIANT & 16) != 0
+// Storm cells for one king, counted the way the census does, once per slot fill.
+static inline int s122_storm(const board_t* b, int colour)
+{
+  const bb_t enemy = b->bitboards[(colour == WHITE) ? B_PAWN : W_PAWN];
+  const bb_t own = b->bitboards[(colour == WHITE) ? W_PAWN : B_PAWN];
+  const int ksq = get_lsb_index(b->bitboards[(colour == WHITE) ? W_KING : B_KING]);
+  const int kf = ksq & 7;
+  const int kr = ksq >> 3;
+  const int step = (colour == WHITE) ? -1 : 1;
+  int sum = 0;
+  for (int file = kf - 1; file <= kf + 1; ++file) {
+    if (file < 0 || file > 7) { continue; }
+    for (int d = 1; d <= 4; ++d) {
+      const int rank = kr + step * d;
+      if (rank < 0 || rank > 7) { break; }
+      if ((enemy >> (rank * 8 + file)) & 1) {
+        const bool blocked = (own >> ((rank - step) * 8 + file)) & 1;
+        sum += (d * 2 + (blocked ? 1 : 0)) * 3;
+        break;
+      }
+    }
+  }
+  return sum;
+}
+#endif
