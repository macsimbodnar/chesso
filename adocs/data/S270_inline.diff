+// The one instance of the attack tables, defined in bitboard.cpp. Written by
+// initialize_game_const_data() alone; everything else reads game_tables().
+extern bb_tables_t shared_tables;
+extern bool shared_tables_ready;
+
 // The attack tables, which are read-only once built and the same for every
 // game. initialize_game_const_data() fills them on the first call and does
 // nothing on later ones, so calling it per game_t is cheap.
-const bb_tables_t* game_tables();
+//
+// Inline since S270. Its Release body is one address, and defined in
+// bitboard.cpp it was a real call from every other unit a build without
+// link-time optimization compiles (0.52 % self time in the 2026-10-08
+// performance audit's profile).
+inline const bb_tables_t* game_tables()
+{
+  assert(shared_tables_ready);
+  return &shared_tables;
+}
 
