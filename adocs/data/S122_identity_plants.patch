--- a/src/search_params.hpp
+++ b/src/search_params.hpp
@@ -1,4 +1,15 @@
 #pragma once
+#include <cstdlib>
+// S122's identity plants, one build and a runtime switch: 1 the trace records White's count
+// off by one, the engine right; 2 the tuner's exact score divides by the wrong divisor; 3 it
+// adds Black's T with the wrong sign; 4 the engine's count is wrong, in the score and the
+// trace alike; 5 T reaches the search's instantiation and not the collecting one.
+inline int s122_plant()
+{
+  static const int value = std::getenv("S122_PLANT") ? std::atoi(std::getenv("S122_PLANT")) : 0;
+  return value;
+}
+extern int s122_debug_units[2];
