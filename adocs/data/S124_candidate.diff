+            game.board.bitboards[(lone == WHITE) ? W_KING : B_KING]);
+        const int stm = (game.board.active_color == WHITE) ? 1 : -1;
+        white_relative[i] = stm * evaluate_cheap(&game.board);
+        phase = game_phase(&game.board);
+      }
+
+      // The lone king's table entry, mirrored and negated for Black as the
+      // accumulators read it, and mop-up's share, signed for the side with men.
+      const int lone_sign = (lone == WHITE) ? 1 : -1;
+      const int men_sign = (test.side == WHITE) ? 1 : -1;
+      auto table = [&](const int (&psqt)[6][64], int square) {
+        return psqt[W_KING][(lone == WHITE) ? square : (square ^ 56)];
+      };
+      const int psqt_mg_delta =
+          lone_sign * (table(psqt_mg, squares[1]) - table(psqt_mg, squares[0]));
+      const int psqt_eg_delta =
