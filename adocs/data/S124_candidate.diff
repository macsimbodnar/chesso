+      {"4k3/8/8/8/8/8/8/3QK3 w - - 0 1", "8/8/8/4k3/8/8/8/3QK3 w - - 0 1", WHITE, "KQvK, e8 to e5"},
+      {"3qk3/8/8/8/8/8/8/4K3 b - - 0 1", "3qk3/8/8/8/4K3/8/8/8 b - - 0 1", BLACK, "KvKQ, e1 to e4"},
+      {"8/8/8/8/8/4K3/6k1/2NB4 w - - 0 1", "8/8/8/4k3/8/4K3/8/2NB4 w - - 0 1", WHITE, "KBNvK, g2 to e5"},
+      {"2nb4/6K1/4k3/8/8/8/8/8 b - - 0 1", "2nb4/8/4k3/8/4K3/8/8/8 b - - 0 1", BLACK, "KvKBN, g7 to e4"},
+    };
