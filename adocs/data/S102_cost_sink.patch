@@ -1595,6 +1711,24 @@
   entry->passers = white_passers | black_passers;
   entry->score = sum;
 
+#if defined(S102_SINK) && (S102_SINK & 4)
+  {
+    // Space's count a side: safe area squares, those on an own pawn's rearspan twice. 12 less it
+    // is stored, so that a zeroed slot, the pawnless board's, reads the pawnless count 12.
+    const bb_t w_safe = s102::space_w & ~white_pawns & ~black_attacks;
+    const bb_t b_safe = s102::space_b & ~black_pawns & ~white_attacks;
+    const bb_t w_rear = white_behind << 8;
+    const bb_t b_rear = black_behind >> 8;
+    const int w = count_bits(w_safe) + count_bits(w_safe & w_rear);
+    const int b = count_bits(b_safe) + count_bits(b_safe & b_rear);
+    entry->spare = static_cast<uint16_t>(static_cast<uint8_t>(12 - w) |
+                                         (static_cast<uint8_t>(12 - b) << 8));
+    const int open = 8 - count_bits((white_pawn_files | black_pawn_files) & 0xFFULL);
+    const int sink = 29 * (w - b) + 31 * (w - b) * open;
+    asm volatile("" : : "r"(sink));
+  }
+#endif
+
   // One rank of each whole-file set: every rank of it is the same eight bits.
   entry->white_files = static_cast<uint8_t>(white_pawn_files);
   entry->black_files = static_cast<uint8_t>(black_pawn_files);
@@ -1931,6 +2065,26 @@
 
   const int score = board->material + positional;
 
+#ifdef S102_SINK
+#if (S102_SINK & 1)
+  {
+    const int sink = s102::outposts(board);
+    asm volatile("" : : "r"(sink));
+  }
+#endif
+#if (S102_SINK & 4)
+  {
+    const int w = 12 - static_cast<int8_t>(entry->spare & 0xFF);
+    const int b = 12 - static_cast<int8_t>(entry->spare >> 8);
+    const bb_t* bbs = board->bitboards;
+    const int wpcs = count_bits(bbs[W_KNIGHT] | bbs[W_BISHOP] | bbs[W_ROOK] | bbs[W_QUEEN]);
+    const int bpcs = count_bits(bbs[B_KNIGHT] | bbs[B_BISHOP] | bbs[B_ROOK] | bbs[B_QUEEN]);
+    const int sink = 17 * (w * wpcs - b * bpcs);
+    asm volatile("" : : "r"(sink));
+  }
+#endif
+#endif
+
   // Tapered on its own rather than summed into the pair above, and that is not
   // a stylistic choice: everything above is White relative and is negated below
   // for Black, and a bonus for having the move must survive that negation
@@ -3283,6 +3437,13 @@
     if (threats_out != nullptr) { *threats_out = mobility - mobility_alone; }
   }
 
+#if defined(S102_SINK) && (S102_SINK & 8)
+  {
+    const int sink = s102::outposts(board);
+    asm volatile("" : : "r"(sink));
+  }
+#endif
+
   return mobility + safety;
 }
 
